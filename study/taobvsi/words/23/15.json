      "word": "தெருக்களிலும்",
      "pos": "noun",
      "canonical": "தெரு",
      "definition_ta": "நகரத்தின் உள்ளே மக்கள் நடமாடும் பொதுவான பாதை.",
      "modern_equivalent": "தெருக்கள்",
      "english_word": "streets",
      "source": "db_0ms"
    },
    {
      "verse": 3,
      "word": "அலறி,",
      "pos": "verb",
      "canonical": "அலறு",
      "definition_ta": "மிகவும் சத்தமாக அல்லது வேதனையோடு கூச்சலிடுதல்.",
      "modern_equivalent": "கூச்சலிட்டான்",
      "english_word": "cried out",
      "source": "db_0ms"
    },
    {
      "verse": 3,
      "word": "அழுதுகொண்டிருக்கிறார்கள்.",
      "pos": "verb",
      "canonical": "அழு",
      "definition_ta": "கண்ணீர் விட்டு வருத்தத்துடன் வருமாறு சத்தம் எழுப்புதல்.",
      "modern_equivalent": "அழுதுகொண்டிருக்கிறார்கள்",
      "english_word": "are weeping",
      "source": "llm_single_pass"
    },
    {
      "verse": 4,
      "word": "எஸ்போன்",
      "pos": "noun",
      "canonical": "எஸ்போன்",
      "definition_ta": "எஸ்போன் என்னும் பெயருடைய ஒரு நபர்.",
      "modern_equivalent": "எஸ்போன்",
      "english_word": "Espon",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "ஊராரும்",
      "pos": "noun",
      "canonical": "ஊர்",
      "definition_ta": "மக்கள் வாழும் குடியிருப்பிடம் அல்லது கிராமம்.",
      "modern_equivalent": "ஊர்",
      "english_word": "town",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "எலெயாலே",
      "pos": "noun",
      "canonical": "எலெயாலே",
      "definition_ta": "எலெயாலே என்பது ஒரு குறிப்பிட்ட ஊரின் பெயர்.",
      "modern_equivalent": "எலெயாலே",
      "english_word": "Elah",
      "source": "llm_single_pass"
    },
    {
      "verse": 4,
      "word": "ஊராரும்",
      "pos": "noun",
      "canonical": "ஊர்",
      "definition_ta": "மக்கள் வாழும் குடியிருப்பிடம் அல்லது கிராமம்.",
      "modern_equivalent": "ஊர்",
      "english_word": "town",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "கூக்குரலிடுகிறார்கள்;",
      "pos": "verb",
      "canonical": "கூக்குரல்",
      "definition_ta": "உயர்ந்த குரலில் சத்தமாகப் பேசுதல் அல்லது கூவல்.",
      "modern_equivalent": "சத்தமிடுகிறார்கள்",
      "english_word": "cry",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "அவர்கள்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "தேவன் மற்றும் அவருடைய வார்த்தையைச் சித்தமாகக் குறிக்கும் பன்மை பிரதிபெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "They",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "சத்தம்",
      "pos": "noun",
      "canonical": "சத்தம்",
      "definition_ta": "காதுகளுக்குக் கேட்கக்கூடிய ஒலி அல்லது கூச்சல்.",
      "modern_equivalent": "சத்தம்",
      "english_word": "cry",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "யாகாஸ்மட்டும்",
      "pos": "noun",
      "canonical": "யாகாஸ்மட்டும்",
      "definition_ta": "யாகாஸ்மட்டும் என்பது ஒரு குறிப்பிட்ட ஊரின் பெயர்.",
      "modern_equivalent": "யாகாஸ்மட்டும்",
      "english_word": "Jachin",
      "source": "llm_single_pass"
    },
    {
      "verse": 4,
      "word": "கேட்கப்படுகிறது;",
      "pos": "verb",
      "canonical": "கேட்கப்படு",
      "definition_ta": "ஒலி அல்லது சத்தம் செவிகளுக்குக் கேட்கும் நிலை.",
      "modern_equivalent": "கேட்கப்படும்",
      "english_word": "be heard",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "ஆகையால்",
      "pos": "conjunction",
      "canonical": "ஆகையால்",
      "definition_ta": "ஒரு செயலின் விளைவாக அல்லது காரணத்தினால் ஏற்படுவதைக் குறிக்கும் இணைப்புச்சொல்.",
      "modern_equivalent": "அதனால்",
      "english_word": "therefore",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "மோவாபின்",
      "pos": "adjective",
      "canonical": "மோவாப்",
      "definition_ta": "மோவாப் என்ற நாட்டின் அல்லது இனத்தைச் சார்ந்த.",
      "modern_equivalent": "மோவாபிய",
      "english_word": "Moabite",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "ஆயுதபாணிகள்",
      "pos": "noun",
      "canonical": "ஆயுதபாணி",
      "definition_ta": "ஆயுதங்களைக் கையாளுவதில் வல்லவரான போர்வீரர்.",
      "modern_equivalent": "ஆயுதமேந்திய போர்வீரர்",
      "english_word": "mighty men of valor",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "கதறுகிறார்கள்;",
      "pos": "verb",
      "canonical": "கதறு",
      "definition_ta": "வலி அல்லது பயத்தினால் ஏற்படும் ஒருவிதமான சத்தமான அழுகை.",
      "modern_equivalent": "அழுகுகிறார்கள்",
      "english_word": "groan",
      "source": "llm_single_pass"
    },
    {
      "verse": 4,
      "word": "அவனவனுடைய",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு தனிமனிதனை அல்லது ஒரு குறிப்பிட்ட நபரைச் சுட்டிக்காட்டுதல்.",
      "modern_equivalent": "அவனுடைய",
      "english_word": "his",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "ஆத்துமா",
      "pos": "noun",
      "canonical": "ஆத்துமா",
      "definition_ta": "ஒரு மனிதனின் உயிர் அல்லது ஆன்மா.",
      "modern_equivalent": "ஆத்துமா",
      "english_word": "soul",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "அவனவனில்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு தனிமனிதனை அல்லது ஒருவரை குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவன்",
      "english_word": "his",
      "source": "llm_single_pass"
    },
    {
      "verse": 4,
      "word": "கிலேசப்படுகிறது.",
      "pos": "verb",
      "canonical": "கிலேசப்படு",
      "definition_ta": "மனதளவில் அல்லது ஆத்துமாவில் ஏற்படும் ஒருவிதமான தவிப்பு அல்லது கலக்க நிலை.",
      "modern_equivalent": "கலக்கப்படுகிறது",
      "english_word": "is troubled",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "இருதயம்",
      "pos": "noun",
      "canonical": "இருதயம்",
      "definition_ta": "மனதின் ஆழமான உணர்வு அல்லது உள்ளத்தின் நிலை.",
      "modern_equivalent": "மனம்",
      "english_word": "hearts",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "மோவாபினிமித்தம்",
      "pos": "noun",
      "canonical": "மோவாப்",
      "definition_ta": "மோவாப் என்று அழைக்கப்படும் ஒரு பண்டைய நிலப்பகுதி அல்லது நாடு.",
      "modern_equivalent": "மோவாப் நாடு",
      "english_word": "Moab",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "ஓலமிடுகிறது;",
      "pos": "verb",
      "canonical": "ஓலம்",
      "definition_ta": "மனதளவில் மிகுந்த வேதனையினால் துடிப்பதை அல்லது தவிப்பதைக் குறிக்கும்.",
      "modern_equivalent": "துடிப்பது",
      "english_word": "faints",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "அதிலிருந்து",
      "pos": "particle",
      "canonical": "அது",
      "definition_ta": "ஒரு பொருளைக் குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "அதிலிருந்து",
      "english_word": "from it",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "ஓடிவருகிறவர்கள்",
      "pos": "noun",
      "canonical": "ஓடிவருகிறவன்",
      "definition_ta": "வேகமாக ஓடி வரும் ஒரு நபர்.",
      "modern_equivalent": "ஓடிவரும்வர்கள்",
      "english_word": "those who flee",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "மூன்று",
      "pos": "numeral",
      "canonical": "மூன்று",
      "definition_ta": "எண்ணிக்கையில் மூன்று என்ற எண்ணிக்கையைக் குறிக்கும்.",
      "modern_equivalent": "3",
      "english_word": "three",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "வயது",
      "pos": "noun",
      "canonical": "வயது",
      "definition_ta": "ஒருவர் வாழ்ந்து வரும் கால அளவு அல்லது காலப்பகுதி.",
      "modern_equivalent": "வயது",
      "english_word": "age",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "கிடாரியைப்போல",
      "pos": "particle",
      "canonical": "போல",
      "definition_ta": "ஒன்றின் சாயலில் அல்லது ஒரு பொருளைப் போன்றே என்பதைக் குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "போல",
      "english_word": "like",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "அலைகிறார்கள்;",
      "pos": "verb",
      "canonical": "அலை",
      "definition_ta": "ஒரு சீரான திசையில்லாமல் அலைந்து திரிவதைக் குறிக்கும்.",
      "modern_equivalent": "அலைந்து திரிவது",
      "english_word": "wander",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "லூகித்துக்கு",
      "pos": "noun",
      "canonical": "லூகித்",
      "definition_ta": "லூகித் என்று அழைக்கப்படும் ஒரு குறிப்பிட்ட மலைப்பகுதி அல்லது நிலப்பகுதி.",
      "modern_equivalent": "லூகித் மலை",
      "english_word": "Luz",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "ஏறிப்போகிற",
      "pos": "verb",
      "canonical": "ஏறிப்போ",
      "definition_ta": "ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு மேலே ஏறிச் செல்லும் செயல்.",
      "modern_equivalent": "ஏறிச் செல்லும்",
      "english_word": "rising",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "வழியிலே",
      "pos": "noun",
      "canonical": "வழி",
      "definition_ta": "ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்குச் செல்லும் பாதை.",
      "modern_equivalent": "பாதையில்",
      "english_word": "way",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "அழுகையோடே",
      "pos": "adverb",
      "canonical": "அழுகை",
      "definition_ta": "சோகத்தினால் ஏற்படும் அழுகுரல் அல்லது புலம்பலுடன்.",
      "modern_equivalent": "அழுகையுடன்",
      "english_word": "with weeping",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "ஏறுகிறார்கள்;",
      "pos": "verb",
      "canonical": "ஏறு",
      "definition_ta": "மேலே நோக்கி நகர்வது அல்லது ஏறுவது.",
      "modern_equivalent": "ஏறுகிறார்கள்",
      "english_word": "go up",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "ஒரோனாயீமின்",
      "pos": "noun",
      "canonical": "ஒரோனாயீன்",
      "definition_ta": "யூதேயாவிற்கு வடக்கே உள்ள ஒரு மலைப்பாதை அல்லது மலைப்பகுதி.",
      "modern_equivalent": "ஒரோனாயீன் மலை",
      "english_word": "the way of Oren",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "வழியிலே",
      "pos": "noun",
      "canonical": "வழி",
      "definition_ta": "ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்குச் செல்லும் பாதை.",
      "modern_equivalent": "பாதையில்",
      "english_word": "way",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "நொறுங்குதலின்",
      "pos": "noun",
      "canonical": "நொறுங்குதல்",
      "definition_ta": "முழுமையாக சிதைந்து அல்லது நொறுங்கி சிதைந்து போகும் நிலை.",
      "modern_equivalent": "நொறுங்குதல்",
      "english_word": "breaking",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "கூக்குரல்",
      "pos": "noun",
      "canonical": "கூக்குரல்",
      "definition_ta": "அதிகப்படியான சத்தம் அல்லது கூச்சலிடுதல்.",
      "modern_equivalent": "சத்தம்",
      "english_word": "clamor",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "இடுகிறார்கள்.",
      "pos": "verb",
      "canonical": "இடு",
      "definition_ta": "ஒரு பொருளை ஒரு இடத்திற்குள் வைக்க அல்லது தள்ளுதல்.",
      "modern_equivalent": "இடுகிறார்கள்",
      "english_word": "curse",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "நிம்ரீமின்",
      "pos": "noun",
      "canonical": "நிம்ரீம்",
      "definition_ta": "நிம்ரீம் என்னும் நாட்டின் பெயர் அல்லது அதன் எல்லை.",
      "modern_equivalent": "நிம்ரீம்",
      "english_word": "Nimrod's",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "நீர்ப்பாய்ச்சலான",
      "pos": "adjective",
      "canonical": "நீர்ப்பாய்ச்சல்",
      "definition_ta": "தண்ணீர் பாய்ந்து அல்லது நீர் சூழ்ந்து காணப்படும் நிலம்.",
      "modern_equivalent": "நீர் சூழ்ந்த",
      "english_word": "marshy",
      "source": "db_0ms"
    },
    {
