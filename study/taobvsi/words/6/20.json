      "pos": "particle",
      "canonical": "கோத்திரம்",
      "definition_ta": "கோபம் அல்லது ஆத்திரம் என்னும் உணர்வை வெளிப்படுத்தும் இடைச்சொல்.",
      "modern_equivalent": "கோபத்திற்கு",
      "english_word": "for anger",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "இருக்கும்",
      "pos": "verb",
      "canonical": "இரு",
      "definition_ta": "ஒரு குறிப்பிட்ட இடத்தில் நிலைபெற்று அல்லது தங்கியிருப்பது.",
      "modern_equivalent": "இருந்த",
      "english_word": "were",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பாசானிலுள்ள",
      "pos": "noun",
      "canonical": "பாசான்",
      "definition_ta": "ஒரு குறிப்பிட்ட நிலப்பரப்பு அல்லது பிரதேசத்தின் பெயர்.",
      "modern_equivalent": "பாசான் பகுதி",
      "english_word": "Bashan",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கோலானையும்",
      "pos": "noun",
      "canonical": "கோலான்",
      "definition_ta": "ஒரு குறிப்பிட்ட நிலப்பரப்பு அல்லது பகுதி",
      "modern_equivalent": "கோலான்",
      "english_word": "Golan",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "குறித்துவைத்தார்கள்.",
      "pos": "verb",
      "canonical": "குறிப்பிடி",
      "definition_ta": "ஒரு குறிப்பிட்ட எல்லை அல்லது பகுதியை அடையாளம் கண்டு குறித்து வைத்தல்.",
      "modern_equivalent": "குறிப்பிட்டார்கள்",
      "english_word": "demarcated",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "கைப்பிசகாய்",
      "pos": "adjective",
      "canonical": "கைப்பிசகம்",
      "definition_ta": "கைப்பிசகம் என்பது ஒரு பொருளைப் பற்றி சிந்திக்காமல் அல்லது கவனிக்காமல் தானாகவே கையில் வந்து சேரும் நிலையைக் குறிக்கும்.",
      "modern_equivalent": "தானாகவே வந்த",
      "english_word": "at your hand",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "ஒருவனைக்",
      "pos": "pronoun",
      "canonical": "ஒருவன்",
      "definition_ta": "ஒரு தனி மனிதன் அல்லது ஒரு நபர்.",
      "modern_equivalent": "ஒருவர்",
      "english_word": "someone",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கொன்றவன்",
      "pos": "noun",
      "canonical": "கொலை",
      "definition_ta": "ஒரு உயிரை அழித்தல் அல்லது மரணமடையச் செய்தல்.",
      "modern_equivalent": "கொன்றவன்",
      "english_word": "killer",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "எவனோ",
      "pos": "pronoun",
      "canonical": "எவன்",
      "definition_ta": "ஒரு நபரை அடையாளம் காண அல்லது கேள்வி கேட்கப் பயன்படும் பிரதிப்பெயர்.",
      "modern_equivalent": "எவனோ",
      "english_word": "whoever",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "அவன்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு ஆண் நபரை அல்லது ஒரு தெய்வத்தைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவன்",
      "english_word": "he",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "சபைக்கு",
      "pos": "noun",
      "canonical": "சபை",
      "definition_ta": "தேவனுடைய மக்கள் அல்லது ஒரு குறிப்பிட்ட கூட்டமைப்பு.",
      "modern_equivalent": "கூட்டம்",
      "english_word": "congregation",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "முன்பாக",
      "pos": "adverb",
      "canonical": "முன்பாக",
      "definition_ta": "முன்பாக: ஒரு செயலுக்கு முன்னதாக அல்லது ஒருவரின் முன்னால் உள்ள நிலை.",
      "modern_equivalent": "முன்னால்",
      "english_word": "before",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "நிற்கும்வரைக்கும்,",
      "pos": "adverb",
      "canonical": "வரை",
      "definition_ta": "ஒரு குறிப்பிட்ட காலம் அல்லது எல்லை வரை தொடரும் நிலை.",
      "modern_equivalent": "வரை",
      "english_word": "until",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பழிவாங்குகிறன்",
      "pos": "adjective",
      "canonical": "பழிவாங்கு",
      "definition_ta": "ஒருவர் செய்த அநீதிக்கு அல்லது குற்றத்திற்குப் பழி அல்லது தண்டனை கொடுக்கும் தன்மை கொண்ட.",
      "modern_equivalent": "பழிவாங்கும்",
      "english_word": "avenging",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "கையினால்",
      "pos": "particle",
      "canonical": "கை",
      "definition_ta": "ஒரு மனிதனின் உடல் உறுப்பான கையை குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "கையால்",
      "english_word": "with hand",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "சாகாதபடிக்கு",
      "pos": "verb",
      "canonical": "சாகாத",
      "definition_ta": "மரணத்தை சந்திக்காமல் தப்பிக்கும்படி என்று பொருள். இது மனிதன் மரணத்தின் முன் நிற்காமல் இருக்க வேண்டும் என்பதைக் குறிக்கிறது.",
      "modern_equivalent": "மரணமில்லாமல்",
      "english_word": "lest you die",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "ஓடிப்போய்",
      "pos": "verb",
      "canonical": "ஓடு",
      "definition_ta": "வேகமாக ஓடிச் சென்று ஒரு இடத்திற்குச் செல்லுதல்.",
      "modern_equivalent": "வேகமாக ஓடிச் சென்றாய்",
      "english_word": "run",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "ஒதுங்கும்படி,",
      "pos": "adverb",
      "canonical": "ஒதுங்கு",
      "definition_ta": "ஒரு பொருளை ஒரு பக்கமாக விலக்கி வைக்கும்படி அல்லது நகர்த்தும்படி செய்யும் வினையடை.",
      "modern_equivalent": "விலகிச் செல்லும்படி",
      "english_word": "to part",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "இஸ்ரவேல்",
      "pos": "noun",
      "canonical": "இஸ்ரவேல்",
      "definition_ta": "யாக்கோபு என்பவருக்கு தேவன் கொடுத்த புதிய பெயர்.",
      "modern_equivalent": "இஸ்ரவேல்",
      "english_word": "Israel",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "புத்திரர்",
      "pos": "noun",
      "canonical": "புத்திரன்",
      "definition_ta": "ஒருவருக்குப் பிறந்த ஆண் பிள்ளை.",
      "modern_equivalent": "ஆண் பிள்ளைகள்",
      "english_word": "sons",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "யாவருக்கும்,",
      "pos": "pronoun",
      "canonical": "யாவர்",
      "definition_ta": "அங்கு இருந்த அனைத்து மக்களையும் குறிக்கும் பொதுவான பிரதிபெயர்.",
      "modern_equivalent": "அனைவருக்கும்",
      "english_word": "all",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "அவர்கள்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "தேவன் மற்றும் அவருடைய வார்த்தையைச் சித்தமாகக் குறிக்கும் பன்மை பிரதிபெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "They",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "நடுவே",
      "pos": "adverb",
      "canonical": "நடுவே",
      "definition_ta": "இருவற்றுக்கு அல்லது இருவருக்கு இடையே உள்ள இடத்தைக் குறிக்கும் வினையடை.",
      "modern_equivalent": "இடையே",
      "english_word": "between",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "தங்குகிற",
      "pos": "adjective",
      "canonical": "தங்கு",
      "definition_ta": "ஒரு இடத்தில் தங்கியிருக்கும் அல்லது தங்குமிடமாக உள்ள.",
      "modern_equivalent": "தங்கியிருக்கும்",
      "english_word": "staying",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பரதேசிக்கும்,",
      "pos": "adjective",
      "canonical": "பரதேசியம்",
      "definition_ta": "ஒரு குறிப்பிட்ட எல்லைக்கு வெளியே அல்லது பரந்த நிலப்பரப்பில் உள்ள.",
      "modern_equivalent": "வெளிப்புற",
      "english_word": "foreign",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "குறிக்கப்பட்ட",
      "pos": "verb",
      "canonical": "குறி",
      "definition_ta": "ஒரு குறிப்பிட்ட அடையாளத்திற்காக அல்லது நோக்கத்திற்காக அடையாளம் காணப்பட்ட.",
      "modern_equivalent": "குறிக்கப்பட்ட",
      "english_word": "designated",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பட்டணங்கள்",
      "pos": "noun",
      "canonical": "பட்டணம்",
      "definition_ta": "ஒரு பெரிய நகரம் அல்லது மக்கள் வாழும் பெரிய குடியிருப்பிடம்.",
      "modern_equivalent": "நகரங்கள்",
      "english_word": "cities",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "இவைகளே.",
      "pos": "pronoun",
      "canonical": "இவை",
      "definition_ta": "முன்னதாகக் கூறப்பட்ட வானம் மற்றும் பூமி உருவாக்கப்பட்ட செய்திகளை இது குறிக்கிறது.",
      "modern_equivalent": "இவைதான்",
      "english_word": "these",
      "source": "db_0ms"
    }
  ]
}