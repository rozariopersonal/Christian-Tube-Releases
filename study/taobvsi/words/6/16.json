      "definition_ta": "எப்பிராயீம் கோத்திரத்தின் எல்லைப் பகுதியில் அமைந்துள்ள ஒரு ஊர்.",
      "modern_equivalent": "தப்புவா",
      "english_word": "Tappuah",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "மேற்கு",
      "pos": "adjective",
      "canonical": "மேற்கு",
      "definition_ta": "மேற்குப் பக்கத்தில் அமைந்துள்ள",
      "modern_equivalent": "மேற்கில் உள்ள",
      "english_word": "western",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "எல்லை,",
      "pos": "noun",
      "canonical": "எல்லை",
      "definition_ta": "ஒரு நாட்டின் அல்லது ஒரு பகுதியின் முடிவு அல்லது எல்லைக் கோடு.",
      "modern_equivalent": "எல்லை",
      "english_word": "boundary",
      "source": "db_0ms"
    },
    {
