      "word": "எப்பிராயீம்",
      "pos": "noun",
      "canonical": "எப்பிராயீம்",
      "definition_ta": "ஒரு குறிப்பிட்ட நபரின் பெயர்.",
      "modern_equivalent": "எப்பிராயீம்",
      "english_word": "Ephraim",
      "source": "db_0ms"
    },
    {
