      "canonical": "புத்திரன்",
      "definition_ta": "ஒரு ஆணின் மகன்.",
      "modern_equivalent": "மகன்",
      "english_word": "sons",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "சுதந்தரத்தின்",
      "pos": "noun",
      "canonical": "சுதந்தரம்",
      "definition_ta": "ஒரு குறிப்பிட்ட எல்லை அல்லது எல்லைக் கோடு.",
      "modern_equivalent": "எல்லை",
      "english_word": "boundary",
      "source": "db_0ms"
    },
    {
