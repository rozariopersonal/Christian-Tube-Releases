      "english_word": "appointed",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "அவன்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு ஆண் நபரை அல்லது ஒரு தெய்வத்தைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவன்",
      "english_word": "he",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "தோளைச்",
      "pos": "noun",
      "canonical": "தோள்",
      "definition_ta": "கழுத்திலிருந்து கையின் தொடக்கம் வரை உள்ள உடல் உறுப்பு.",
      "modern_equivalent": "தோள்",
      "english_word": "shoulder",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "சுமைக்கு",
      "pos": "noun",
      "canonical": "சுமை",
      "definition_ta": "தாங்குவதற்கு கடினமாக இருக்கும் பாரம் அல்லது பொறுப்பு.",
      "modern_equivalent": "சுமை, பாரம்",
      "english_word": "burden",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "விலக்கினேன்;",
      "pos": "verb",
      "canonical": "விலக்கு",
      "definition_ta": "ஒரு பொருளை அல்லது ஒருவரை ஒரு இடத்திலிருந்து அகற்றி விடுதல்.",
      "modern_equivalent": "விலக்கினேன், அகற்றினேன்",
      "english_word": "removed",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "அவன்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு ஆண் நபரை அல்லது ஒரு தெய்வத்தைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவன்",
      "english_word": "he",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "கைகள்",
      "pos": "noun",
      "canonical": "கை",
      "definition_ta": "மனித உடலின் ஒரு உறுப்பு, செயல்களைச் செய்யப் பயன்படும் பகுதி.",
      "modern_equivalent": "கைகள்",
      "english_word": "hands",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "கூடைக்கு",
      "pos": "noun",
      "canonical": "கூடை",
      "definition_ta": "பொருட்களைச் சேகரித்து வைக்கப் பயன்படும் ஒரு கொள்கலன்.",
      "modern_equivalent": "கூடை, தொட்டி",
      "english_word": "basket",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "நீங்கலாக்கப்பட்டது.",
      "pos": "verb",
      "canonical": "நீங்கு",
      "definition_ta": "ஒரு பொருளை ஒரு இடத்திலிருந்து பிரித்து அல்லது அகற்றி விடுதல்.",
      "modern_equivalent": "நீங்கலாக்கப்பட்டது, அகற்றப்பட்டது",
      "english_word": "taken away",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "நெருக்கத்திலே",
      "pos": "adverb",
      "canonical": "நெருக்கம்",
      "definition_ta": "மிகவும் அருகாமையில் அல்லது நெருக்கமான நிலையில்.",
      "modern_equivalent": "அருகில்",
      "english_word": "nearness",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நீ",
      "pos": "pronoun",
      "canonical": "நீ",
      "definition_ta": "தேவன் ஆதாமுக்கு உரையாடும்போது அவனைக் குறிக்கப் பயன்படுத்திய இரண்டாம் நபர் ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "நீ",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "கூப்பிட்டாய்,",
      "pos": "verb",
      "canonical": "கூப்பிடு",
      "definition_ta": "ஒருவரை அழைத்தல் அல்லது ஒருவரை நோக்கி குரல் கொடுத்தல்.",
      "modern_equivalent": "அழைத்தாய்",
      "english_word": "called",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "நான்",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னைத்தானே குறிக்கும் ஒருமைப் பிரதிப்பெயர்.",
      "modern_equivalent": "நான்",
      "english_word": "I",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உன்னைத்",
      "pos": "pronoun",
      "canonical": "நீ",
      "definition_ta": "உன்னை என்று குறிக்கும் இரண்டாம் நபர் பிரதிப்பெயர்",
      "modern_equivalent": "உன்னை",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "தப்புவித்தேன்;",
      "pos": "verb",
      "canonical": "தப்புவி",
      "definition_ta": "ஒருவரை ஒருவரின் பிடியிலிருந்து விடுவித்தல் அல்லது தப்பித்தல்.",
      "modern_equivalent": "தப்பிப்பிடித்தேன்",
      "english_word": "delivered",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "இடிமுழக்கம்",
      "pos": "noun",
      "canonical": "இடிமுழக்கம்",
      "definition_ta": "வானத்தில் மின்னலுடன் ஏற்படும் உரத்தமான சத்தம்.",
      "modern_equivalent": "இடி",
      "english_word": "thunder",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "உண்டாகும்",
      "pos": "verb",
      "canonical": "உண்டாகு",
      "definition_ta": "ஏற்படுதல் அல்லது தோன்றுதல்",
      "modern_equivalent": "உண்டாகும்",
      "english_word": "arose",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "மறைவிடத்திலிருந்து",
      "pos": "noun",
      "canonical": "மறைவிடம்",
      "definition_ta": "கண்ணுக்குத் தெரியாத அல்லது மறைக்கப்பட்ட இடம்.",
      "modern_equivalent": "மறைவான இடம்",
      "english_word": "secret place",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "உனக்கு",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "தேவன் ஆதாமின் பாவத்தை நோக்கி அவனிடம் பேசும்போது, அவனுக்கு என்று பொருள்படும் விதத்தில் சொல்லப்பட்டது.",
      "modern_equivalent": "உனக்கு",
      "english_word": "to you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உத்தரவு",
      "pos": "noun",
      "canonical": "உத்தரவு",
      "definition_ta": "ஒரு அதிகாரமிக்க நபர் பிறருக்குக் கொடுக்கும் கட்டளை அல்லது ஆணை.",
      "modern_equivalent": "ஆணை",
      "english_word": "answered",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "அருளினேன்;",
      "pos": "verb",
      "canonical": "அருள்",
      "definition_ta": "தேவன் ஒருவருக்குக் கொடுப்பது அல்லது வழங்குவது.",
      "modern_equivalent": "கொடுத்தேன்",
      "english_word": "gave",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "மேரிபாவின்",
      "pos": "noun",
      "canonical": "மேரிபா",
      "definition_ta": "ஒரு குறிப்பிட்ட இடத்தின் அல்லது ஊரின் பெயர்.",
      "modern_equivalent": "மேரிபா",
      "english_word": "Meribah",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "தண்ணீர்களிடத்தில்",
      "pos": "noun",
      "canonical": "தண்ணீர்",
      "definition_ta": "ஒரு உயிர் வாழத் தேவையான திரவமான பொருள்.",
      "modern_equivalent": "நீர்",
      "english_word": "waters",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "உன்னைச்",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "உன்னைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னை",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "சோதித்து",
      "pos": "verb",
      "canonical": "சோதி",
      "definition_ta": "ஒருவருடைய உண்மைத்தன்மை அல்லது திறமையை அறிய சோதனை செய்தல்.",
      "modern_equivalent": "சோதித்தார்",
      "english_word": "tested",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "அறிந்தேன்.",
      "pos": "verb",
      "canonical": "அறி",
      "definition_ta": "ஒரு செய்தியை அல்லது உண்மையை உணர்ந்து தெரிந்து கொள்ளுதல்.",
      "modern_equivalent": "தெரிந்துகொண்டேன்",
      "english_word": "I knew",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "(சேலா)",
      "pos": "noun",
      "canonical": "சேலா",
      "definition_ta": "ஒரு குறிப்பிட்ட நபரின் பெயர் அல்லது அடையாளப் பெயர்.",
      "modern_equivalent": "சேலா",
      "english_word": "Shelah",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "ஜனமே",
      "pos": "noun",
      "canonical": "ஜனம்",
      "definition_ta": "ஒரு குறிப்பிட்ட தேசத்தைச் சேர்ந்த மக்கள் அல்லது ஒரு கூட்டத்தினர்.",
      "modern_equivalent": "மக்கள்",
      "english_word": "people",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கேள்,",
      "pos": "verb",
      "canonical": "கேள்",
      "definition_ta": "ஒருவர் கூறுவதை கவனமாகக் கேட்டுப் புரிந்துகொள்ளுதல்.",
      "modern_equivalent": "கேளு",
      "english_word": "listen",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உனக்குச்",
      "pos": "pronoun",
      "canonical": "உனக்கு",
      "definition_ta": "உன்னைப் பற்றிலும் உனக்காகவும் என்று குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உனக்கு",
      "english_word": "to you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "சாட்சியிட்டுச்",
      "pos": "verb",
      "canonical": "சாட்சி",
      "definition_ta": "ஒரு உண்மையைப் பற்றிச் சான்று அளித்தல் அல்லது உறுதிப்படுத்துதல்.",
      "modern_equivalent": "சான்று கூறி",
      "english_word": "bearing witness",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "சொல்லுவேன்;",
      "pos": "verb",
      "canonical": "சொல்",
      "definition_ta": "ஒரு செய்தியை அல்லது தகவலை வாய்மொழியாக வெளிப்படுத்துதல்.",
      "modern_equivalent": "சொல்வேன்",
      "english_word": "say",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "இஸ்ரவேலே,",
      "pos": "noun",
      "canonical": "இஸ்ரவேல்",
      "definition_ta": "தேவனால் தேர்ந்தெடுக்கப்பட்ட ஒரு குறிப்பிட்ட மக்கள் கூட்டம் அல்லது ஒரு தேசம்.",
      "modern_equivalent": "இஸ்ரவேல்",
      "english_word": "Israel",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நீ",
      "pos": "pronoun",
      "canonical": "நீ",
      "definition_ta": "தேவன் ஆதாமுக்கு உரையாடும்போது அவனைக் குறிக்கப் பயன்படுத்திய இரண்டாம் நபர் ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "நீ",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "எனக்குச்",
      "pos": "pronoun",
      "canonical": "எனக்கு",
      "definition_ta": "தன்னைப் பற்றிய குறிப்பு அல்லது ஒருவருக்குரிய உரிமை அல்லது பொருளைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "எனக்கு",
      "english_word": "to me",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "செவிகொடுத்தால்",
      "pos": "verb",
      "canonical": "செவிகொடு",
      "definition_ta": "ஒருவர் சொல்லும் கருத்தை அல்லது கட்டளையை கவனமாகக் கேட்டு அதன்படி நடக்கும் செயல்.",
      "modern_equivalent": "கவனித்தால்",
      "english_word": "listen",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நலமாயிருக்கும்.",
      "pos": "verb",
      "canonical": "நலம்",
      "definition_ta": "நன்மை அல்லது நலம் என்று கருதுதல்; ஒரு நிலை அல்லது சூழல் சாதகமாக இருத்தல்.",
      "modern_equivalent": "நல்லதாக இருக்கும்",
      "english_word": "would be better",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "உனக்குள்",
      "pos": "adverb",
      "canonical": "உனக்குள்",
      "definition_ta": "உன்னுடைய உள்ளே அல்லது உன்னிடத்தில் உள்ள நிலையை குறிக்கும் வினையடை.",
      "modern_equivalent": "உனக்குள்",
      "english_word": "in you",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "வேறு",
      "pos": "adjective",
      "canonical": "வேறு",
      "definition_ta": "ஒன்றிலிருந்து வேறுபட்ட அல்லது வேறொரு வகை.",
      "modern_equivalent": "வேறு",
      "english_word": "another",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "தேவன்",
