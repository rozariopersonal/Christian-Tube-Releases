      "pos": "particle",
      "canonical": "கர்த்தர்",
      "definition_ta": "கர்த்தர் என்னும் பெயருடன் இணைந்த ஒரு இடைச்சொல் அல்லது வேற்றுமை உருபு.",
      "modern_equivalent": "கர்த்தரில்",
      "english_word": "in the Lord",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "அன்புகூருகிறவர்களே,",
      "pos": "noun",
      "canonical": "அன்புகூருகிறவர்",
      "definition_ta": "அன்பு செலுத்துபவர்கள் அல்லது அன்பானவர்கள் என்று அழைக்கப்படுபவர்கள்.",
      "modern_equivalent": "அன்பானவர்கள்",
      "english_word": "beloved",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "தீமையை",
      "pos": "noun",
      "canonical": "தீமை",
      "definition_ta": "நன்மைக்கு எதிரான கெட்ட செயல் அல்லது ஒழுக்கமற்ற காரியம்.",
      "modern_equivalent": "கெட்ட事",
      "english_word": "evil",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "வெறுத்துவிடுங்கள்;",
      "pos": "verb",
      "canonical": "வெறு",
      "definition_ta": "ஒரு பொருளை அல்லது செயலை வெறுத்து அல்லது விலக்கி விடுதல்.",
      "modern_equivalent": "வெறுத்துவிடுங்கள்",
      "english_word": "forsake",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "அவர்",
      "pos": "pronoun",
      "canonical": "அவர்",
      "definition_ta": "தேவனாகிய கர்த்தரை இந்த வாக்கியத்தில் குறிக்கிறது.",
      "modern_equivalent": "அவர்",
      "english_word": "He",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "தம்முடைய",
      "pos": "pronoun",
      "canonical": "தம்",
      "definition_ta": "தேவன் தனக்கே உரிய கிரியையைச் செய்வதைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "தன்",
      "english_word": "his",
      "source": "db_disambiguated"
    },
    {
      "verse": 10,
      "word": "பரிசுத்தவான்களின்",
      "pos": "noun",
      "canonical": "பரிசுத்தவான்",
      "definition_ta": "தேவனுக்கு посвященப்பட்ட அல்லது பரிசுத்தமான ஒரு நபர்.",
      "modern_equivalent": "பரிசுத்தமானவர்கள்",
      "english_word": "saints",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "ஆத்துமாக்களைக்",
      "pos": "noun",
      "canonical": "ஆத்துமா",
      "definition_ta": "உயிரோட்டம் அல்லது உயிர் உள்ள ஆன்மா.",
      "modern_equivalent": "ஆத்துமாக்கள்",
      "english_word": "souls",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "காப்பாற்றி,",
      "pos": "verb",
      "canonical": "காப்பாடு",
      "definition_ta": "ஆபத்து அல்லது தீங்கிலிருந்து ஒருவரைப் பாதுகாத்தல்.",
      "modern_equivalent": "பாதுகாத்தார்",
      "english_word": "keep",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "துன்மார்க்கரின்",
      "pos": "adjective",
      "canonical": "துன்மார்க்கர்",
      "definition_ta": "தீமை செய்கிற அல்லது தேவனுக்கு விரோதமான செயல்களைச் செய்கிற",
      "modern_equivalent": "தீய",
      "english_word": "wicked",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "கைக்கு",
      "pos": "noun",
      "canonical": "கை",
      "definition_ta": "உடலின் ஒரு உறுப்பு அல்லது ஒருவரின் அதிகாரத்தைக் குறிக்கும் சொல்.",
      "modern_equivalent": "கை",
      "english_word": "hand",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "அவர்களைத்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "பலருக்கான பிரதிப்பெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "them",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "தப்புவிக்கிறார்.",
      "pos": "verb",
      "canonical": "தப்புவி",
      "definition_ta": "ஒருவரை ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு அல்லது ஒரு நிலையிலிருந்து மற்றொரு நிலைக்கு மாற்றும் செயல்.",
      "modern_equivalent": "மாற்றுவார்",
      "english_word": "deliver",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "நீதிமானுக்காக",
      "pos": "noun",
      "canonical": "நீதிமான்",
      "definition_ta": "கடவுளுடைய கட்டளைகளுக்குக் கீழ்ப்படிந்து நடக்கும் நீதிமானான ஒரு நபர்.",
      "modern_equivalent": "நீதிமான்",
      "english_word": "righteous",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "வெளிச்சமும்,",
      "pos": "noun",
      "canonical": "வெளிச்சம்",
      "definition_ta": "இருளை நீக்கும் ஒளி அல்லது பிரகாசம்.",
      "modern_equivalent": "ஒளி",
      "english_word": "light",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "செம்மையான",
      "pos": "adjective",
      "canonical": "செம்மை",
      "definition_ta": "மிகவும் சுத்தமான, குறையற்ற அல்லது மிகச்சிறந்த பண்பு.",
      "modern_equivalent": "சிறந்த",
      "english_word": "excellent",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "இருதயத்தாருக்காக",
      "pos": "noun",
      "canonical": "செம்மையான இருதயம்",
      "definition_ta": "தூய்மையான மற்றும் நேர்மையான உள்ளம்.",
      "modern_equivalent": "தூய்மையான உள்ளம்",
      "english_word": "upright heart",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "மகிழ்ச்சியும்",
      "pos": "noun",
      "canonical": "மகிழ்ச்சி",
      "definition_ta": "மனதின் உள்ளான சந்தோஷம் அல்லது பேரின்பம்.",
      "modern_equivalent": "சந்தோஷம்",
      "english_word": "joy",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "விதைக்கப்பட்டிருக்கிறது.",
      "pos": "verb",
      "canonical": "விதை",
      "definition_ta": "ஒரு பொருளை வளரச் செய்ய மண்ணில் அல்லது இடத்தில் போடுதல்.",
      "modern_equivalent": "விதைக்கப்பட்டது",
      "english_word": "is sown",
      "source": "llm_single_pass"
    },
    {
      "verse": 12,
      "word": "நீதிமான்களே,",
      "pos": "noun",
      "canonical": "நீதிமான்",
      "definition_ta": "தேவனுடைய கட்டளைகளுக்குக் கீழ்ப்படிந்து நடக்கும் நீதிமானான மனிதன்.",
      "modern_equivalent": "நீதிமான்கள்",
      "english_word": "righteous",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "கர்த்தருக்குள்",
      "pos": "particle",
      "canonical": "கர்த்தர்",
      "definition_ta": "ஆண்டவராகிய தேவன்.",
      "modern_equivalent": "கர்த்தருக்குள்",
      "english_word": "in the Lord",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "மகிழ்ந்து,",
      "pos": "verb",
      "canonical": "மகிழ்",
      "definition_ta": "மனதில் மிகுந்த மகிழ்ச்சியையோ அல்லது இன்பத்தையோ அடைதல்.",
      "modern_equivalent": "மகிழ்ச்சியடைந்தனர்",
      "english_word": "rejoiced",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "அவருடைய",
      "pos": "pronoun",
      "canonical": "அவருடைய",
      "definition_ta": "ஒரு குறிப்பிட்ட நபரை அல்லது ஒரு பொருளைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவருடைய",
      "english_word": "his",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "பரிசுத்தத்தின்",
      "pos": "noun",
      "canonical": "பரிசுத்தம்",
      "definition_ta": "பாவமில்லாத, தூய்மையான அல்லது புனிதமான நிலை.",
      "modern_equivalent": "பரிசுத்தம்",
      "english_word": "holiness",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "நினைவுகூருதலைக்",
      "pos": "noun",
      "canonical": "நினைவுகூருதல்",
      "definition_ta": "கடந்த கால நிகழ்வுகளை அல்லது செயல்களை மனதில் கொண்டு நினைத்துப் பார்ப்பது.",
      "modern_equivalent": "நினைவு",
      "english_word": "remembrance",
      "source": "llm_single_pass"
    },
    {
      "verse": 12,
      "word": "கொண்டாடுங்கள்.",
      "pos": "verb",
      "canonical": "கொண்டாடு",
      "definition_ta": "மகிழ்ச்சியுடன் ஒரு நிகழ்வை அல்லது ஒரு நற்செய்தியை கொண்டாடுதல்.",
      "modern_equivalent": "ஆഘോഷப்படுத்துங்கள்",
      "english_word": "rejoice",
      "source": "db_0ms"
    }
  ]
}