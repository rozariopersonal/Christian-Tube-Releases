      "definition_ta": "முழங்கால் முழங்கால் அடித்து அல்லது பலமாக தாக்கி அழித்தல்.",
      "modern_equivalent": "அடித்தல்",
      "english_word": "trample",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "அரணான",
      "pos": "adjective",
      "canonical": "அரண்",
      "definition_ta": "பாதுகாப்புக்காகக் கட்டப்பட்ட கோட்டை அல்லது பாதுகாப்பு அரண்.",
      "modern_equivalent": "பாதுகாப்பான",
      "english_word": "fortified",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "பட்டணத்திற்குள்",
      "pos": "noun",
      "canonical": "பட்டணம்",
      "definition_ta": "ஒரு குறிப்பிட்ட எல்லைக்குள் அமைந்திருக்கும் மக்கள் வாழும் குடியிருப்பிடம்.",
      "modern_equivalent": "நகரம்",
      "english_word": "city",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "என்னை",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "பேசும் பெண்ணான ஸ்திரீயானவளைப் பற்றிய பிரதிபெயரைக் குறிக்கிறது.",
      "modern_equivalent": "என்னை",
      "english_word": "me",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "நடத்திக்கொண்டு",
      "pos": "verb",
      "canonical": "நடத்து",
      "definition_ta": "ஒரு கூட்டத்தையோ அல்லது கூட்டமாக உள்ளவற்றையோ வழிநடத்துதல்.",
      "modern_equivalent": "வழிநடத்து",
      "english_word": "leading",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "போகிறவன்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு குறிப்பிட்ட ஆணை அல்லது செயலைச் செய்யும் ஒரு நபர் அல்லது ஒருவரைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவன்",
      "english_word": "he who",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "யார்?",
      "pos": "pronoun",
      "canonical": "யார்",
      "definition_ta": "ஆதாம் தனது தவறை மறைக்க தேவன் கேட்கும் வினாவிலுள்ள வினாப்பெயர்.",
      "modern_equivalent": "யார்",
      "english_word": "who",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "ஏதோம்மட்டும்",
      "pos": "adverb",
      "canonical": "ஏதோ",
      "definition_ta": "குறிப்பிட்ட ஒன்றைத் தவிர மற்றொன்றை அல்லது ஏதோ ஒரு பொருளைக் குறிக்கும் சொல்.",
      "modern_equivalent": "ஏதோ ஒன்று",
      "english_word": "something",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "எனக்கு",
      "pos": "pronoun",
      "canonical": "எனக்கு",
      "definition_ta": "எனக்கு: 'நான்' என்ற பிரதிப்பெயரின் ஒருமைப் பொருள், ஒருவருக்குரிய அல்லது ஒருவருக்குரிய என்பதை உணர்த்துகிறது.",
      "modern_equivalent": "எனக்கு",
      "english_word": "to me",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "வழிகாட்டுகிறவன்",
      "pos": "noun",
      "canonical": "வழிகாட்டி",
      "definition_ta": "ஒருவருக்கு சரியான பாதையை அல்லது வழியை காண்பிக்கும் நபர்.",
      "modern_equivalent": "வழிகாட்டி",
      "english_word": "guide",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "யார்?",
      "pos": "pronoun",
      "canonical": "யார்",
      "definition_ta": "ஆதாம் தனது தவறை மறைக்க தேவன் கேட்கும் வினாவிலுள்ள வினாப்பெயர்.",
      "modern_equivalent": "யார்",
      "english_word": "who",
      "source": "db_0ms"
    },
    {
