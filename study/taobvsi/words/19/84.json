      "word": "அழுகையின்",
      "pos": "noun",
      "canonical": "அழுகை",
      "definition_ta": "துயரத்தினால் ஏற்படும் அழுகுரல்.",
      "modern_equivalent": "அழுகல்",
      "english_word": "wailing",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "பள்ளத்தாக்கை",
      "pos": "noun",
      "canonical": "பள்ளத்தாக்கு",
      "definition_ta": "ஒரு குறிப்பிட்ட நிலப்பரப்பு அல்லது பள்ளத்தாக்கு.",
      "modern_equivalent": "பள்ளத்தாக்கு",
      "english_word": "valley",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "உருவ",
      "pos": "noun",
      "canonical": "உருவ",
      "definition_ta": "ஒரு பொருளின் வடிவம் அல்லது அமைப்பு.",
      "modern_equivalent": "வடிவம்",
      "english_word": "form",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "நடந்து",
      "pos": "verb",
      "canonical": "நட",
      "definition_ta": "கால்களை முன்னெடுத்து முன்னேறிச் செல்லுதல்.",
      "modern_equivalent": "நடந்து",
      "english_word": "walk",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "அதை",
