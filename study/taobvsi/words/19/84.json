      "definition_ta": "ஒரு பொருளின் மேல் அல்லது மீது அமைந்துள்ள நிலையை குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "மேலே",
      "english_word": "upon",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "பலம்",
      "pos": "noun",
      "canonical": "பலம்",
      "definition_ta": "ஒருவர் обладаக்கும் உடல் வலிமை அல்லது ஆற்றல்.",
      "modern_equivalent": "வலிமை",
      "english_word": "strength",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "அடைந்து,",
      "pos": "verb",
      "canonical": "அடை",
      "definition_ta": "அடைந்து: ஒரு எல்லை அல்லது எல்லையை தாண்டிச் செல்லுதல்.",
      "modern_equivalent": "கடந்து",
      "english_word": "crossed",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "சீயோனிலே",
      "pos": "noun",
      "canonical": "சீயோன்",
      "definition_ta": "எருசலேமுக்கு அருகிலுள்ள ஒரு மலை அல்லது புனிதமான நகரத்தைக் குறிக்கும் பெயர்.",
      "modern_equivalent": "சீயோன்",
      "english_word": "Zion",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "தேவசந்நிதியில்",
