      "verse": 4,
      "word": "(சேலா)",
      "pos": "noun",
      "canonical": "சேலா",
      "definition_ta": "ஒரு குறிப்பிட்ட நபரின் பெயர் அல்லது அடையாளப் பெயர்.",
      "modern_equivalent": "சேலா",
      "english_word": "Shelah",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "உம்மிலே",
      "pos": "pronoun",
      "canonical": "உம்",
      "definition_ta": "உன்னைப் என்று குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உம்மில்",
      "english_word": "in you",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "பெலன்கொள்ளுகிற",
      "pos": "verb",
      "canonical": "பெலன்கொள்",
      "definition_ta": "வலிமை அல்லது பலத்தைப் பெறுதல் அல்லது பெறுதல்.",
      "modern_equivalent": "பலம்பெறுபவர்",
      "english_word": "strengthened",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "மனுஷனும்,",
      "pos": "noun",
      "canonical": "மனுஷன்",
      "definition_ta": "மனிதன் அல்லது மனித இனத்தைச் சேர்ந்தவர்.",
      "modern_equivalent": "மனிதன்",
      "english_word": "man",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "தங்கள்",
      "pos": "pronoun",
      "canonical": "தங்கள்",
      "definition_ta": "தங்கள் சொந்தமான அல்லது தங்களுக்குரிய என்று பொருள்படும் பிரதிப் பெயர்.",
      "modern_equivalent": "அவர்களுடைய",
      "english_word": "Their",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "இருதயங்களில்",
      "pos": "noun",
      "canonical": "இதயம்",
      "definition_ta": "உணர்ச்சிகள் மற்றும் எண்ணங்கள் உருவாகும் உடலின் உட்புற உறுப்பு.",
      "modern_equivalent": "மனம்",
      "english_word": "hearts",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "செவ்வையான",
      "pos": "adjective",
      "canonical": "செவ்வாய்",
      "definition_ta": "நேரான அல்லது சரியான.",
      "modern_equivalent": "நேரான",
      "english_word": "straight",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "வழிகளைக்",
      "pos": "noun",
      "canonical": "வழி",
      "definition_ta": "ஒருவர் செல்ல வேண்டிய பாதை அல்லது ஒரு செயலைச் செய்ய வேண்டிய முறை.",
      "modern_equivalent": "பாதைகள்",
      "english_word": "paths",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "கொண்டிருக்கிறவர்களும்",
      "pos": "verb",
      "canonical": "கொண்டிரு",
      "definition_ta": "ஒரு பொருளை அல்லது பண்பை ஒருவரிடம் இருத்தல் அல்லது வைத்திருத்தல்.",
      "modern_equivalent": "வைத்திருப்பவர்கள்",
      "english_word": "who have",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "பாக்கியவான்கள்.",
      "pos": "noun",
      "canonical": "பாக்கியவான்",
      "definition_ta": "அதிகமான நன்மைகளையும் ஆசீர்வாதங்களையும் பெற்றவர்.",
      "modern_equivalent": "ஆசீர்வதிக்கப்பட்டவர்கள்",
      "english_word": "blessed",
      "source": "db_0ms"
    },
    {
