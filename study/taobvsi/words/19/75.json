      "definition_ta": "மரத்தின் தண்டு அல்லது தண்டுக்களிலிருந்து வெளிவரும் கிளை.",
      "modern_equivalent": "கிளை",
      "english_word": "branch",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "உயரமாய்",
      "pos": "adverb",
      "canonical": "உயரம்",
      "definition_ta": "அதிகமான உயரத்தில் அல்லது மேலேயாக.",
      "modern_equivalent": "உயரமாக",
      "english_word": "high",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "உயர்த்தாதிருங்கள்;",
      "pos": "verb",
      "canonical": "உயர்த்து",
      "definition_ta": "ஒரு பொருளை மேல்நோக்கி நகர்த்துதல் அல்லது மேலே நிலைநிறுத்துதல்.",
      "modern_equivalent": "உயர்த்துங்கள்",
      "english_word": "lift up",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "இறுமாப்புள்ள",
      "pos": "adjective",
      "canonical": "இறுமாப்பு",
      "definition_ta": "அதிகமான பெருமை அல்லது அகந்தை கொண்ட.",
      "modern_equivalent": "பெருமைமிக்க",
      "english_word": "proud",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "கழுத்துடையவர்களாய்ப்",
      "pos": "noun",
      "canonical": "கழுத்து",
      "definition_ta": "தலைக்கும் தோள்பட்டையிடைக்கும் உள்ள உறுப்பு; பெருமையின் அடையாளமாகப் பயன்படுத்தப்படும் சொல்.",
      "modern_equivalent": "கழுத்து",
      "english_word": "neck",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "பேசாதிருங்கள்.",
      "pos": "verb",
      "canonical": "பேசு",
      "definition_ta": "வாய் திறந்து வார்த்தைகளை வெளியிடுதல்.",
      "modern_equivalent": "பேசாதீர்கள்",
      "english_word": "speak",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "கிழக்கிலும்",
      "pos": "adverb",
      "canonical": "கிழக்கு",
      "definition_ta": "கிழக்கு திசையைக் குறிக்கும் வினையடை.",
      "modern_equivalent": "கிழக்கு நோக்கி",
      "english_word": "east",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "மேற்கிலும்",
      "pos": "adverb",
      "canonical": "மேற்கு",
      "definition_ta": "மேற்கு திசையைக் குறிக்கும் வினையடை.",
      "modern_equivalent": "மேற்கு நோக்கி",
      "english_word": "north",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "வனாந்தரதிசையிலுமிருந்து",
      "pos": "noun",
      "canonical": "வனாந்தரதிசை",
      "definition_ta": "வனங்கள் நிறைந்த அடர்ந்த காடு அல்லது மக்கள் வசிவாதமற்ற காட்டுப்பகுதி.",
      "modern_equivalent": "காடு",
      "english_word": "wilderness",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "ஜெயம்",
      "pos": "noun",
      "canonical": "ஜெயம்",
      "definition_ta": "வெற்றி அல்லது ஒரு செயலில் அடைந்த சாதனை.",
      "modern_equivalent": "வெற்றி",
      "english_word": "victory",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "வராது.",
      "pos": "verb",
      "canonical": "வா",
      "definition_ta": "ஒரு இடத்திற்கு வருதல் அல்லது ஒரு நிலையை அடைதல்.",
      "modern_equivalent": "வராது",
      "english_word": "will not come",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "தேவனே",
      "pos": "noun",
      "canonical": "தேவன்",
      "definition_ta": "சர்வ வல்லமையுள்ள படைத்தவர் அல்லது கடவுள்.",
      "modern_equivalent": "கடவுள்",
      "english_word": "God",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நியாயாதிபதி;",
      "pos": "noun",
      "canonical": "நியாயாதிபதி",
      "definition_ta": "நீதியை வழங்கும் அதிகாரம் கொண்ட நீதிபதி.",
      "modern_equivalent": "நீதிபதி",
      "english_word": "Judge",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "ஒருவனைத்",
      "pos": "pronoun",
      "canonical": "ஒருவன்",
      "definition_ta": "குறிப்பிட்ட அடையாளம் இல்லாத ஒரு தனி மனிதன்.",
      "modern_equivalent": "ஒருவர்",
      "english_word": "a person",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "தாழ்த்தி,",
      "pos": "verb",
      "canonical": "தாழ்",
      "definition_ta": "தன்னை அடக்கிக்கொண்டு பணிவாக மாறுதல்.",
      "modern_equivalent": "தாழ்த்தி",
      "english_word": "humble",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "ஒருவனை",
      "pos": "noun",
      "canonical": "ஒருவன்",
      "definition_ta": "ஒரே ஒரு தனிநபர் அல்லது ஒரு மனிதன்.",
      "modern_equivalent": "ஒருவர்",
      "english_word": "one",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உயர்த்துகிறார்.",
      "pos": "verb",
      "canonical": "உயர்த்து",
      "definition_ta": "ஒருவரை உயர்ந்த நிலைக்கு அல்லது உயர்வான இடத்திற்கு கொண்டு வருதல்.",
      "modern_equivalent": "மேம்படுத்துகிறார்",
      "english_word": "lifts up",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கலங்கிப்",
      "pos": "adjective",
      "canonical": "கலங்கிய",
      "definition_ta": "ஒன்றோடு ஒன்று கலந்து குழம்பான அல்லது கலந்த நிலை.",
      "modern_equivalent": "கலந்த",
      "english_word": "mixed",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "பொங்குகிற",
      "pos": "adjective",
      "canonical": "பொங்கிய",
      "definition_ta": "அதிகமாக கொதிக்கும் அல்லது சீறிப்பாயும் நிலை.",
      "modern_equivalent": "கொதிக்கும்",
      "english_word": "bubbling",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "மதுபானத்தினால்",
      "pos": "noun",
      "canonical": "மதுபானம்",
      "definition_ta": "மது அல்லது போதை தரும் பானம்.",
      "modern_equivalent": "மது",
      "english_word": "wine",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "நிறைந்த",
      "pos": "adjective",
      "canonical": "நிறைந்த",
      "definition_ta": "முழுமையாக வளர்ந்த அல்லது நிறைவான நிலை.",
      "modern_equivalent": "முழுமையான",
      "english_word": "full",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பாத்திரம்",
      "pos": "noun",
      "canonical": "பாத்திரம்",
      "definition_ta": "ஒரு பொருளைப் போடுவதற்கு அல்லது சேமிப்பதற்குப் பயன்படும் ஒரு கொள்கலன்.",
      "modern_equivalent": "பாத்திரம்",
      "english_word": "vessel",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கர்த்தருடைய",
      "pos": "noun",
      "canonical": "கர்த்தர்",
      "definition_ta": "ஆண்டவராகிய தேவன் அல்லது இறைவனின் அதிகாரப்பூர்வமான பெயர்.",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "LORD",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கையிலிருக்கிறது,",
      "pos": "verb",
      "canonical": "இரு",
      "definition_ta": "ஒரு பொருளைப் பெற்று வைத்திருப்பது அல்லது ஒரு பொருள் ஒருவரின் கட்டுப்பாட்டில் இருப்பது.",
      "modern_equivalent": "இருக்கிறது",
      "english_word": "is in",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "அதிலிருந்து",
      "pos": "particle",
      "canonical": "அது",
      "definition_ta": "ஒரு பொருளைக் குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "அதிலிருந்து",
      "english_word": "from it",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "வார்க்கிறார்;",
      "pos": "verb",
      "canonical": "வாரு",
      "definition_ta": "ஒரு பாத்திரத்திலிருந்து மற்றொரு இடத்திற்கு ஊற்றுதல்.",
      "modern_equivalent": "ஊற்றுவார்",
      "english_word": "pours",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "பூமியிலுள்ள",
      "pos": "adjective",
      "canonical": "பூமி",
      "definition_ta": "பூமியின் மீது நிலைபெற்று அல்லது பூமியில் உள்ள என்று பொருள்படும்.",
      "modern_equivalent": "பூமியில் உள்ள",
      "english_word": "earthly",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "துன்மார்க்கர்",
      "pos": "adjective",
      "canonical": "துன்மார்க்கர்",
      "definition_ta": "தீமை செய்யும் அல்லது ஒழுக்கமற்றவர்கள்.",
      "modern_equivalent": "தீயவர்கள்",
      "english_word": "wicked",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "யாவரும்",
      "pos": "pronoun",
      "canonical": "யாவர்",
      "definition_ta": "பூமியில் வாழ்ந்த அனைத்து மனிதர்களையும் குறிக்கும் பொதுவான பிரதிபெயர்.",
      "modern_equivalent": "அனைவரும்",
      "english_word": "all",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "அதின்",
      "pos": "pronoun",
      "canonical": "அது",
      "definition_ta": "அங்கே உள்ள அந்த விருட்சத்தைக் குறிக்கும் பிரதிப்பெயரைக் குறிக்கிறது.",
      "modern_equivalent": "அதனுடைய",
      "english_word": "its",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "வண்டல்களை",
      "pos": "noun",
      "canonical": "வண்டல்",
      "definition_ta": "திரவத்தில் உள்ள படிந்த அல்லது தரைக்கீழ் படிந்த துகள்கள்.",
      "modern_equivalent": "கழிவுகள்",
      "english_word": "dregs",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "உறிஞ்சிக்",
      "pos": "verb",
      "canonical": "உறி",
      "definition_ta": "உள்ளே இழுத்துக்கொள்வது அல்லது உள்வாங்குவது.",
      "modern_equivalent": "உள்ளி",
      "english_word": "drink",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "குடிப்பார்கள்.",
      "pos": "verb",
      "canonical": "குடி",
      "definition_ta": "வாய் வழியாக ஒரு திரவத்தை உள்ளே செலுத்தி உட்கொள்வது.",
      "modern_equivalent": "உட்கொள்வார்கள்",
      "english_word": "will drink",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "நானோ",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னைத் தானே குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "நான்",
      "english_word": "I",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "என்றென்றைக்கும்",
      "pos": "adverb",
      "canonical": "என்றென்றைக்கும்",
      "definition_ta": "எப்பொழுதும் அல்லது எல்லா காலங்களிலும்",
      "modern_equivalent": "எப்போதும்",
      "english_word": "forever",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "இதை",
      "pos": "pronoun",
      "canonical": "இது",
      "definition_ta": "முன்னர் குறிப்பிட்ட ஒரு பொருளைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "இதை",
      "english_word": "this",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "அறிவித்து,",
      "pos": "verb",
      "canonical": "அறிவி",
      "definition_ta": "ஒரு தகவலை மற்றவருக்கு தெரிவித்தல் அல்லது அறிவித்தல்",
      "modern_equivalent": "சொன்னார்",
      "english_word": "told",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "யாக்கோபின்",
      "pos": "noun",
      "canonical": "யாக்கோபு",
      "definition_ta": "இஸ்ரவேல் புத்திரர்களில் ஒருவரும் இஸ்ரவேலின் தலைவருமான ஒரு நபர்.",
      "modern_equivalent": "யாக்கோபு",
      "english_word": "Jacob",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "தேவனைக்",
      "pos": "noun",
      "canonical": "தேவன்",
      "definition_ta": "இந்த உலகைப் படைத்து ஆளும் சர்வவல்லமையுள்ள கடவுள்.",
      "modern_equivalent": "கடவுள்",
      "english_word": "God",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கீர்த்தனம்பண்ணுவேன்.",
      "pos": "verb",
      "canonical": "கீர்த்தனம்",
      "definition_ta": "தேவனுக்காகவோ அல்லது ஒரு புனிதமான விஷயத்திற்காகவோ பாடப்படும் பாடல்.",
      "modern_equivalent": "பாடுகிறேன்",
      "english_word": "sing praises",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "துன்மார்க்கருடைய",
      "pos": "adjective",
      "canonical": "துன்மார்க்க",
