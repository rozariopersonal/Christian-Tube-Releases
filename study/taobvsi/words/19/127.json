      "word": "அவர்கள்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "தேவன் மற்றும் அவருடைய வார்த்தையைச் சித்தமாகக் குறிக்கும் பன்மை பிரதிபெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "They",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "நாணமடையாமல்",
      "pos": "adverb",
      "canonical": "நாணமடையாத",
      "definition_ta": "பயப்படாமல் அல்லது அஞ்சாமல்",
      "modern_equivalent": "பயப்படாமல்",
      "english_word": "without fear",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "ஒலிமுகவாசலில்",
      "pos": "noun",
      "canonical": "ஒலிமுகவாசல்",
      "definition_ta": "பட்டணத்தின் நுழைவாயில் அல்லது மக்கள் கூடும் பொதுவான நுழைவுப் பகுதி.",
      "modern_equivalent": "நுழைவாயில்",
      "english_word": "gate",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "சத்துருக்களோடே",
      "pos": "noun",
      "canonical": "சத்துரு",
      "definition_ta": "எதிரியோ அல்லது பகைவனோ என்று பொருள்.",
      "modern_equivalent": "எதிரிகள்",
      "english_word": "enemies",
      "source": "db_0ms"
    },
