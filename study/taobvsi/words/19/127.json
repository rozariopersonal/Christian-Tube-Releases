      "word": "பலவான்",
      "pos": "adjective",
      "canonical": "பலவான்",
      "definition_ta": "மிகுந்த வலிமை அல்லது ஆற்றல் கொண்ட",
      "modern_equivalent": "வலிமையான",
      "english_word": "mighty",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "கையிலுள்ள",
      "pos": "adjective",
      "canonical": "கை",
      "definition_ta": "ஒருவர் பொருட்களைப் பிடித்துக் கொள்ளும் உடல் உறுப்பு.",
      "modern_equivalent": "கையில் உள்ள",
      "english_word": "in my hand",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "அம்புகளுக்கு",
      "pos": "noun",
      "canonical": "அம்பு",
      "definition_ta": "வில்லில் இருந்து எறியப்படும் ஒரு கூர்மையான ஆயுதம்",
      "modern_equivalent": "அம்பு",
      "english_word": "arrows",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "ஒப்பாயிருக்கிறார்கள்.",
