      "definition_ta": "ஒரே நிலையில் அல்லது சமமான நிலையில் இருத்தல்.",
      "modern_equivalent": "சமமாக இருக்கிறார்கள்",
      "english_word": "are like",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "(6)",
      "pos": "numeral",
      "canonical": "6",
      "definition_ta": "ஆறு என்ற எண்ணைக் குறிக்கும்",
      "modern_equivalent": "6",
      "english_word": "6",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "அவைகளால்",
