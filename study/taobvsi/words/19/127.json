      "word": "நிரப்பின",
      "pos": "verb",
      "canonical": "நிறப்பு",
      "definition_ta": "ஒருவரை ஒரு குறிப்பிட்ட பண்பு அல்லது திறமையால் நிரப்புதல் அல்லது நிரப்புதல்.",
      "modern_equivalent": "நிரப்பின",
      "english_word": "filled",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "புருஷன்",
      "pos": "noun",
      "canonical": "புருஷன்",
      "definition_ta": "ஆண் மனிதன் அல்லது கணவன் என்று பொருள்படும் சொல்.",
      "modern_equivalent": "ஆண்",
      "english_word": "man",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "பாக்கியவான்;",
      "pos": "adjective",
      "canonical": "பாக்கியவான்",
      "definition_ta": "அதிகமான நன்மைகளையும் ஆசீர்வாதங்களையும் பெற்றவர்.",
      "modern_equivalent": "ஆசீர்வதிக்கப்பட்ட",
      "english_word": "blessed",
      "source": "db_0ms"
    },
    {
