      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "தேவனை அல்லது ஒரு குறிப்பிட்ட நபரை ஒருமைப் பிரதிபெயராகக் குறிக்கும்.",
      "modern_equivalent": "அவரை",
      "english_word": "Him",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "தாழ்த்துகிறார்.",
      "pos": "verb",
      "canonical": "தாழ்",
      "definition_ta": "தன்னைக் குறைத்துக் கொள்ளுதல் அல்லது பணிவாக இருத்தல்.",
      "modern_equivalent": "பணிந்து கொள்கிறார்",
      "english_word": "humbles",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "அவர்",
      "pos": "pronoun",
      "canonical": "அவர்",
      "definition_ta": "தேவனாகிய கர்த்தரை இந்த வாக்கியத்தில் குறிக்கிறது.",
      "modern_equivalent": "அவர்",
      "english_word": "He",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "சிறியவனைப்",
      "pos": "noun",
      "canonical": "சிறியவன்",
      "definition_ta": "சமூகத்தில் தாழ்ந்த நிலையில் உள்ள அல்லது பலவீனமான ஒரு நபர்.",
      "modern_equivalent": "தாழ்ந்தவன்",
      "english_word": "the lowly",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "புழுதியிலிருந்து",
      "pos": "noun",
      "canonical": "புழுதி",
      "definition_ta": "மண்ணில் இருந்து வரும் மிக நுண்ணிய துகள்கள் அல்லது தூசி.",
      "modern_equivalent": "தூசி",
      "english_word": "dust",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "தூக்கிவிடுகிறார்;",
      "pos": "verb",
      "canonical": "தூக்கு",
      "definition_ta": "மேலே நோக்கி உயர்த்தி விடுதல் அல்லது ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு நகர்த்துதல்.",
      "modern_equivalent": "தூக்கிவிடுவார்",
      "english_word": "lifts up",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "எளியவனைக்",
      "pos": "noun",
      "canonical": "எளியவன்",
      "definition_ta": "செல்வம் அல்லது அதிகாரமற்ற, எளிய நிலையில் வாழும் ஒரு நபர்.",
      "modern_equivalent": "ஏழை",
      "english_word": "the poor",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "குப்பையிலிருந்து",
      "pos": "noun",
      "canonical": "குப்பை",
      "definition_ta": "தேவையற்ற பொருட்கள் அல்லது எறிந்துவிடப்பட்ட கழிவுகள்.",
      "modern_equivalent": "கழிவு",
      "english_word": "refuse",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உயர்த்துகிறார்.",
      "pos": "verb",
      "canonical": "உயர்த்து",
      "definition_ta": "ஒருவரை உயர்ந்த நிலைக்கு அல்லது உயர்வான இடத்திற்கு கொண்டு வருதல்.",
      "modern_equivalent": "மேம்படுத்துகிறார்",
      "english_word": "lifts up",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "அவனைப்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு ஆண்பவரை அல்லது ஒரு பொருளைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவனை",
      "english_word": "him",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பிரபுக்களோடும்,",
      "pos": "noun",
      "canonical": "பிரபு",
      "definition_ta": "அதிகாரம் அல்லது அதிகாரம் கொண்ட ஆளுமை கொண்ட ஒரு நபர்.",
      "modern_equivalent": "தலைவர்கள்",
      "english_word": "lords",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "தமது",
      "pos": "pronoun",
      "canonical": "தமது",
      "definition_ta": "அவருடைய அல்லது அவருடைய என்று பொருள்படும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவருடைய",
      "english_word": "his",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "ஜனத்தின்",
      "pos": "noun",
      "canonical": "ஜனம்",
      "definition_ta": "ஒரு குறிப்பிட்ட கூட்டத்தினர் அல்லது ஒரு தேசத்தின் மக்கள்.",
      "modern_equivalent": "மக்கள்",
      "english_word": "people",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "அதிபதிகளோடும்",
      "pos": "noun",
      "canonical": "அதிபதி",
      "definition_ta": "ஒரு பகுதியை அல்லது ஒரு குழுவை ஆட்சி செய்யும் அதிகாரம் கொண்டவர்.",
      "modern_equivalent": "ஆளுநர்",
      "english_word": "princes",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உட்காரப்பண்ணுகிறார்.",
      "pos": "verb",
      "canonical": "உட்கார",
      "definition_ta": "ஒரு இடத்தில் அமர்ந்து தங்குதல் அல்லது ஒரு கூட்டத்தில் பங்கேற்பு கொள்ளுதல்.",
      "modern_equivalent": "அமர்ந்திருக்கிறார்",
      "english_word": "sits",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "மலடியைச்",
      "pos": "noun",
      "canonical": "மலாடி",
      "definition_ta": "ஒரு வகை ஆடு அல்லது சிறிய விலங்கு.",
      "modern_equivalent": "ஆடு",
      "english_word": "lamb",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "சந்தோஷமான",
      "pos": "adjective",
      "canonical": "சந்தோஷமான",
      "definition_ta": "மகிழ்ச்சியையும் மகிழ்ச்சியையும் வெளிப்படுத்தும் பண்பு.",
      "modern_equivalent": "மகிழ்ச்சியான",
      "english_word": "joyful",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "பிள்ளைத்தாய்ச்சியாக்கி,",
      "pos": "verb",
      "canonical": "மாற்று",
      "definition_ta": "ஒரு பொருளை அல்லது நிலையை வேறொரு நிலைக்கு மாற்றுதல்.",
      "modern_equivalent": "மாற்றுகிறார்",
      "english_word": "transforms",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "வீட்டிலே",
      "pos": "noun",
      "canonical": "வீடு",
      "definition_ta": "மனிதர்கள் வசிக்கும் அல்லது தங்கும் தங்குமிடம்.",
      "modern_equivalent": "வீட்டில்",
      "english_word": "in his house",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "குடியிருக்கப்பண்ணுகிறார்.",
      "pos": "verb",
      "canonical": "வாழ",
      "definition_ta": "ஒரு இடத்தில் தங்குதல் அல்லது வசித்தல்.",
      "modern_equivalent": "வாழச்செய்யிறார்",
      "english_word": "makes (them) dwell",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "அல்லேலூயா.",
      "pos": "interjection",
      "canonical": "அல்லேலூயா",
      "definition_ta": "கர்த்தருக்குப் புகழும் துதியையும் செலுத்தும் ஒரு விசுவாசப் பாராட்டுச் சொல்.",
      "modern_equivalent": "கர்த்தருக்குப் புகழ்ச்சம்",
      "english_word": "Hallelujah",
      "source": "db_0ms"
    }
  ]
}