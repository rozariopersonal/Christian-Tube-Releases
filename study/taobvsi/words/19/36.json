      "verse": 8,
      "word": "தாகத்தைத்",
      "pos": "noun",
      "canonical": "தாகம்",
      "definition_ta": "தண்ணீர் குடிப்பதற்கான உடல் சார்ந்த தேவை அல்லது தாகம்.",
      "modern_equivalent": "தாகம்",
      "english_word": "thirst",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "தீர்க்கிறீர்.",
      "pos": "verb",
      "canonical": "தீர்க்க",
      "definition_ta": "ஒரு தேவையை அல்லது தாகத்தை நிறைவேற்றுதல் அல்லது போக்குதல்.",
      "modern_equivalent": "நிறைவேற்றுதல்",
      "english_word": "satisfy",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "ஜீவவூற்று",
      "pos": "noun",
      "canonical": "ஜீவவூற்று",
      "definition_ta": "உயிரைக் கொடுக்கும் அல்லது புதுப்பிக்கும் ஒரு தெய்வீகமான நீர் ஆதாரம்.",
      "modern_equivalent": "ஜீவஊற்று",
      "english_word": "spring of living water",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "உம்மிடத்தில்",
      "pos": "particle",
      "canonical": "உம்",
      "definition_ta": "உங்களுடைய அல்லது உம்மோடு தொடர்புடைய என்பதைக் குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "உங்களிடம்",
      "english_word": "with you",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "இருக்கிறது;",
      "pos": "verb",
      "canonical": "இரு",
      "definition_ta": "ஒரு பொருள் அல்லது நிலை ஒரு இடத்தில் நிலைபெற்று இருப்பதை இது குறிக்கிறது.",
      "modern_equivalent": "உள்ளது",
      "english_word": "is",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "உம்முடைய",
      "pos": "pronoun",
      "canonical": "உம்",
      "definition_ta": "உம்முடைய என்பதைக் குறிக்கும் இரண்டாம் ஒருமை பிரதிப்பெயர்",
      "modern_equivalent": "உம்",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "வெளிச்சத்திலே",
      "pos": "noun",
      "canonical": "வெளிச்சம்",
      "definition_ta": "இருளை நீக்கும் ஒளி.",
      "modern_equivalent": "ஒளி",
      "english_word": "light",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "வெளிச்சம்",
      "pos": "noun",
      "canonical": "வெளிச்சம்",
      "definition_ta": "இருளை நீக்கும் ஒளி அல்லது பிரகாசம்.",
      "modern_equivalent": "ஒளி",
      "english_word": "light",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "காண்கிறோம்.",
      "pos": "verb",
      "canonical": "காண்",
      "definition_ta": "கண்களால் ஒரு பொருளைப் பார்ப்பது அல்லது உணர்தல்.",
      "modern_equivalent": "பார்க்கிறோம்",
      "english_word": "see",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "உம்மை",
      "pos": "pronoun",
      "canonical": "உம்",
      "definition_ta": "பேசும் நபரை அல்லது கேட்பவரை குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னை",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "அறிந்தவர்கள்மேல்",
      "pos": "pronoun",
      "canonical": "அறிந்தவர்கள்",
      "definition_ta": "உங்களை அறிந்த அல்லது உணர்ந்த நபர்களைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அறிந்தவர்கள் மீது",
      "english_word": "on those who know you",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "உமது",
      "pos": "pronoun",
      "canonical": "உமது",
      "definition_ta": "தேவன் அல்லது அதிகாரமிக்க ஒருவருடைய சொந்தத்தைக் குறிக்கும் மரியாதையான சொல்.",
      "modern_equivalent": "உமது",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "கிருபையையும்,",
      "pos": "noun",
      "canonical": "கிருபை",
      "definition_ta": "தேவன் ஒருவருக்குக் கொடுக்கிற தயவு அல்லது undeserved favor.",
      "modern_equivalent": "தயவு",
      "english_word": "mercy",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "செம்மையான",
      "pos": "adjective",
      "canonical": "செம்மை",
      "definition_ta": "மிகவும் சுத்தமான, குறையற்ற அல்லது மிகச்சிறந்த பண்பு.",
      "modern_equivalent": "சிறந்த",
      "english_word": "excellent",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "இருதயமுள்ளவர்கள்மேல்",
      "pos": "pronoun",
      "canonical": "இருதயமுள்ளவர்கள்",
      "definition_ta": "உண்மையான அல்லது சுத்தமான உள்ளம் கொண்ட நபர்களைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உள்ளம் சுத்தமானவர்கள் மீது",
      "english_word": "on those with clean hearts",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "உமது",
      "pos": "pronoun",
      "canonical": "உமது",
      "definition_ta": "தேவன் அல்லது அதிகாரமிக்க ஒருவருடைய சொந்தத்தைக் குறிக்கும் மரியாதையான சொல்.",
      "modern_equivalent": "உமது",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "நீதியையும்",
      "pos": "noun",
      "canonical": "நீதி",
      "definition_ta": "சரியான மற்றும் நேர்மையான செயல்பாடு.",
      "modern_equivalent": "நீதியையும்",
      "english_word": "righteousness",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "பாராட்டியருளும்.",
      "pos": "verb",
      "canonical": "பாராட்டி",
      "definition_ta": "அருளொளி அல்லது கிருபையை தந்து உதவி செய்தல்.",
      "modern_equivalent": "அருளொளி செய்",
      "english_word": "be gracious",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "பெருமைக்காரரின்",
      "pos": "noun",
      "canonical": "பெருமைக்காரன்",
      "definition_ta": "தன்னை விட உயர்ந்தவனாக எண்ணி மற்றவர்களை தாழ்வாக கருதும் ஒரு நபர்.",
      "modern_equivalent": "அகங்கக்காரன்",
      "english_word": "the proud",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "கால்",
      "pos": "noun",
      "canonical": "கால்",
      "definition_ta": "மனிதனின் அல்லது விலங்கின் நடப்பதற்குப் பயன்படும் உடல் உறுப்பு.",
      "modern_equivalent": "பாதம்",
      "english_word": "foot",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "என்மேல்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "தன்னை அல்லது தன்னைச் சார்ந்த ஒன்றைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "on me",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "வராமலும்,",
      "pos": "verb",
      "canonical": "வா",
      "definition_ta": "ஒரு குறிப்பிட்ட இடத்தில் அல்லது காலத்திற்குள் இடம்பெறுதல் அல்லது வருதல்.",
      "modern_equivalent": "வருதல்",
      "english_word": "come",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "துன்மார்க்கருடைய",
      "pos": "adjective",
      "canonical": "துன்மார்க்க",
      "definition_ta": "தீமையான வழியில் நடக்கும் அல்லது ஒழுக்கமற்ற செயல்களைச் செய்யும் மக்கள்.",
      "modern_equivalent": "தீயவர்கள்",
      "english_word": "of the wicked",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "கை",
      "pos": "noun",
      "canonical": "கை",
      "definition_ta": "மனித உடலின் ஒரு உறுப்பு அல்லது ஒருவருடைய ஆற்றலை குறிக்கும் சொல்.",
      "modern_equivalent": "கை",
      "english_word": "hand",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "என்னைப்",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னை அல்லது தன்னை குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "என்னை",
      "english_word": "me",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "பறக்கடியாமலும்",
      "pos": "verb",
      "canonical": "பறக்கடி",
      "definition_ta": "ஒருவரை தரையில் விழும்படி பலமாக தள்ளி அல்லது அடித்து கீழே விழச் செய்தல்.",
      "modern_equivalent": "தள்ளிவிட",
      "english_word": "knock down",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "இருப்பதாக.",
      "pos": "verb",
      "canonical": "இரு",
      "definition_ta": "இருக்க வேண்டும் அல்லது இருப்பதாய் என்று பொருள்படும் வினையெச்சம்.",
      "modern_equivalent": "இருக்கட்டும்",
      "english_word": "be",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "அதோ",
      "pos": "adverb",
      "canonical": "அதோ",
      "definition_ta": "அங்கே அல்லது இதோ என்று ஒரு பொருளைக் காண்பிக்கும் வினையடை.",
      "modern_equivalent": "இதோ",
      "english_word": "Behold",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "அக்கிரமக்காரர்",
      "pos": "adjective",
      "canonical": "அக்கிரமம்",
      "definition_ta": "சட்டத்திற்கு அல்லது ஒழுங்கிற்கு எதிராகச் செயல்படும் பண்பு.",
      "modern_equivalent": "பாவக்காரர்",
      "english_word": "wrongdoers",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "விழுந்தார்கள்;",
      "pos": "verb",
      "canonical": "விழு",
      "definition_ta": "ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு கீழே விழுதல் அல்லது விழுந்து விழுந்து விழுதல்.",
      "modern_equivalent": "விழுந்தார்கள்",
      "english_word": "fell",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "எழுந்திருக்கமாட்டாமல்",
      "pos": "verb",
      "canonical": "எழுந்திரு",
      "definition_ta": "நின்ற நிலையில் இருந்து மேலே எழும்பி நிற்பதை குறிக்கும் வினைச்சொல்.",
      "modern_equivalent": "எழுந்து நிற்காமல்",
      "english_word": "without rising",
      "source": "llm_single_pass"
    },
    {
      "verse": 12,
      "word": "தள்ளுண்டுபோனார்கள்.",
      "pos": "verb",
      "canonical": "தள்ளு",
      "definition_ta": "ஒரு திசையில் வேகமாக உருண்டு அல்லது நகர்ந்து செல்லும் செயலை குறிக்கும் வினைச்சொல்.",
      "modern_equivalent": "தள்ளுந்து சென்றார்கள்",
      "english_word": "rolled away",
      "source": "llm_single_pass"
    }
  ]
}