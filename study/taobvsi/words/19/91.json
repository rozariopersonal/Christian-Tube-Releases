      "definition_ta": "முன்னதாகக் குறிப்பிடப்பட்ட ஆகாயவிரிவைக் குறிக்கும் பிரதிப் பெயர்.",
      "modern_equivalent": "அது",
      "english_word": "it",
      "source": "db_disambiguated"
    },
    {
      "verse": 7,
      "word": "உன்னை",
      "pos": "pronoun",
      "canonical": "நீ",
      "definition_ta": "இந்த வசனத்தில் வேதனையை அனுபவிக்கும் அந்தப் பெண்ணைக் குறிக்கும் பிரதிபெயர்.",
      "modern_equivalent": "உன்னை",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "அணுகாது.",
      "pos": "verb",
      "canonical": "அணுக",
      "definition_ta": "ஒருவரை நெருங்கிச் செல்லுதல் அல்லது ஒருவரைத் தொடுதல்.",
      "modern_equivalent": "அணுகாது",
      "english_word": "will not come near",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உன்",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "உன்னுடைய அல்லது உன்னுடைய சொந்தமான என்பதைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னுடைய",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கண்களால்",
      "pos": "particle",
      "canonical": "கண்",
      "definition_ta": "கண் என்னும் உறுப்பினால் அல்லது கண்ணின் வழியாக என்று குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "கண்ணால்",
      "english_word": "with eyes",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "மாத்திரம்",
      "pos": "adverb",
      "canonical": "மாத்திரம்",
      "definition_ta": "வேறு எதையும் தவிர, குறிப்பிட்ட ஒன்றை மட்டும் குறிக்கும் வினையடை.",
      "modern_equivalent": "மட்டும்",
      "english_word": "only",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நீ",
      "pos": "pronoun",
      "canonical": "நீ",
      "definition_ta": "தேவன் ஆதாமுக்கு உரையாடும்போது அவனைக் குறிக்கப் பயன்படுத்திய இரண்டாம் நபர் ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "நீ",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "அதைப்",
      "pos": "pronoun",
      "canonical": "அது",
      "definition_ta": "தேவன் ஆசீர்வதித்து பரிசுத்தமாக்கிய ஏழாம் நாளைக் குறிக்கிறது.",
      "modern_equivalent": "அதை",
      "english_word": "it",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பார்த்து,",
      "pos": "verb",
      "canonical": "பார்",
      "definition_ta": "கண்களால் ஒரு பொருளை அல்லது ஒருவரை நோக்குதல் அல்லது கவனித்தல்.",
      "modern_equivalent": "பார்த்தாள்",
      "english_word": "saw",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "துன்மார்க்கருக்கு",
