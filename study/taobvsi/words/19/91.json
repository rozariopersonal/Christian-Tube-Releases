      "verse": 9,
      "word": "அடைக்கலமாயிருக்கிற",
      "pos": "adjective",
      "canonical": "அடைக்கலம்",
      "definition_ta": "பாதுகாப்பு அல்லது தஞ்சம் அளிக்கும் இடம்.",
      "modern_equivalent": "பாதுகாப்பான",
      "english_word": "refuge",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "உன்னதமான",
      "pos": "adjective",
