      "word": "வரும்",
      "pos": "verb",
      "canonical": "வா",
      "definition_ta": "ஒரு இடத்திற்கு அல்லது நிலையை நோக்கி நகர்ந்து வருதல்.",
      "modern_equivalent": "வரும்",
      "english_word": "coming",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பலனைக்",
      "pos": "noun",
      "canonical": "பலம்",
      "definition_ta": "ஒரு பயிரிலிருந்து கிடைக்கும் விளைச்சல் அல்லது ஆதாயம்.",
      "modern_equivalent": "விளைச்சல்",
      "english_word": "yield",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "காண்பாய்.",
      "pos": "verb",
