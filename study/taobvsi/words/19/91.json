      "definition_ta": "பரிசு: ஒருவருக்குக் கொடுக்கப்படும் பரிசு அல்லது ஒருவருக்குக் கொடுக்கப்படும் பொருள்.",
      "modern_equivalent": "பரிசு",
      "english_word": "prize",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "கேடகமுமாகும்.",
      "pos": "noun",
      "canonical": "கேடகம்",
      "definition_ta": "பாதுகாப்புக்காக அல்லது மறைப்பதற்காகப் பயன்படுத்தப்படும் ஒரு பாதுகாப்பு அரண்.",
      "modern_equivalent": "பாதுகாப்பு அரண்",
      "english_word": "fortress",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "இரவில்",
      "pos": "adverb",
      "canonical": "இரவு",
      "definition_ta": "சூரியன் மறைந்திருக்கும் அந்தகாரமான காலப்பகுதி.",
      "modern_equivalent": "இரவில்",
      "english_word": "at night",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "உண்டாகும்",
      "pos": "verb",
      "canonical": "உண்டாகு",
      "definition_ta": "ஏற்படுதல் அல்லது தோன்றுதல்",
      "modern_equivalent": "உண்டாகும்",
      "english_word": "arose",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "பயங்கரத்துக்கும்,",
      "pos": "noun",
      "canonical": "பயங்கரம்",
      "definition_ta": "அதிர்ச்சியூட்டும் அல்லது அச்சமூட்டும் ஒரு நிலை அல்லது பொருள்.",
      "modern_equivalent": "அச்சம்",
      "english_word": "terror",
      "source": "llm_single_pass"
    },
    {
      "verse": 5,
      "word": "பகலில்",
      "pos": "adverb",
      "canonical": "பகல்",
      "definition_ta": "சூரியன் உதித்திருக்கும் காலப்பகுதி அல்லது பகல்நேரம்.",
      "modern_equivalent": "பகலில்",
      "english_word": "in the day",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "பறக்கும்",
      "pos": "verb",
      "canonical": "பற",
      "definition_ta": "வானத்தில் சிறகுகளைப் பயன்படுத்தி நகரும் செயலைக் குறிக்கிறது.",
      "modern_equivalent": "பறத்தல்",
      "english_word": "flying",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "அம்புக்கும்,",
      "pos": "noun",
      "canonical": "அம்பு",
      "definition_ta": "வில்லில் இருந்து எறியப்படும் ஒரு கூர்மையான ஆயுதம்.",
      "modern_equivalent": "அம்பு",
      "english_word": "arrow",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "இருளில்",
      "pos": "noun",
      "canonical": "இருள்",
      "definition_ta": "ஒளி இல்லாத நிலை அல்லது இருண்ட நிலை.",
      "modern_equivalent": "இருட்டில்",
      "english_word": "darkness",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "நடமாடும்",
      "pos": "verb",
      "canonical": "நட",
      "definition_ta": "ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு நகர்ந்து செல்லும் செயல்.",
      "modern_equivalent": "நடக்கும்",
      "english_word": "walking",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "கொள்ளை",
      "pos": "noun",
      "canonical": "கொள்ளை",
      "definition_ta": "திருட்டு அல்லது வலுக்கட்டாயமாகப் பறிமுதல் செய்யப்படும் பொருள்.",
      "modern_equivalent": "திருட்டு",
      "english_word": "plunder",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "நோய்க்கும்,",
      "pos": "noun",
      "canonical": "நோய்",
      "definition_ta": "உடலை அல்லது உயிரை பாதிக்கும் உடல்நலக்குறைவு அல்லது பாதிப்பு.",
      "modern_equivalent": "நோய்",
      "english_word": "disease",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "மத்தியானத்தில்",
      "pos": "adverb",
      "canonical": "மதியம்",
      "definition_ta": "பகல் நேரத்தின் நடுப்பகுதி அல்லது நண்பகல் நேரம்.",
      "modern_equivalent": "நண்பகல்",
      "english_word": "noon",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "பாழாக்கும்",
      "pos": "verb",
      "canonical": "பாழாக்கு",
      "definition_ta": "ஒரு பொருளை அல்லது நிலத்தை அழித்தல் அல்லது சிதைத்தல்.",
      "modern_equivalent": "அழிக்கும்",
      "english_word": "destroy",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "சங்காரத்துக்கும்",
      "pos": "noun",
      "canonical": "சங்காரம்",
      "definition_ta": "உயிரைப் பறிக்கும் அல்லது அழிக்கும் ஒரு சக்தி அல்லது விபத்து.",
      "modern_equivalent": "அழிவு",
      "english_word": "destruction",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "பயப்படாதிருப்பாய்.",
      "pos": "verb",
      "canonical": "பய",
      "definition_ta": "அச்சம் அல்லது ஒரு ஆபத்தை கண்டு ஏற்படும் மனதின் கலக்கம்.",
      "modern_equivalent": "பயப்படமாட்டாய்",
      "english_word": "you shall not fear",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "உன்",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "உன்னுடைய அல்லது உன்னுடைய சொந்தமான என்பதைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னுடைய",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "பக்கத்தில்",
      "pos": "adverb",
      "canonical": "பக்கம்",
      "definition_ta": "ஒரு பொருளின் அருகில் அல்லது அதன் பக்கவாட்டில் உள்ள நிலை.",
      "modern_equivalent": "அருகில்",
      "english_word": "beside",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "ஆயிரம்பேரும்,",
      "pos": "numeral",
      "canonical": "ஆயிரம்",
      "definition_ta": "ஆயிரம் என்பது ஒரு பெரிய எண்ணிக்கையைக் குறிக்கும் எண்.",
      "modern_equivalent": "ஆயிரம்",
      "english_word": "thousands",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உன்",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "உன்னுடைய அல்லது உன்னுடைய சொந்தமான என்பதைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னுடைய",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "வலதுபுறத்தில்",
