      "canonical": "மனுஷன்",
      "definition_ta": "தேவனால் படைக்கப்பட்ட மனிதன் அல்லது மனித இனம்.",
      "modern_equivalent": "மனிதன்",
      "english_word": "man",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "கடிந்துகொண்டு",
      "pos": "verb",
      "canonical": "கடி",
      "definition_ta": "கடுமையாகக் கடிந்து அல்லது கண்டித்து எச்சரித்தல்.",
      "modern_equivalent": "கண்டித்து",
      "english_word": "rebuked",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "தண்டிக்கிறபோது,",
      "pos": "verb",
      "canonical": "தண்டிக்க",
      "definition_ta": "தவறு செய்தவருக்கு உரிய தண்டனையை வழங்குதல்.",
      "modern_equivalent": "தண்டிக்கிறபோது",
      "english_word": "when you punish",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "அவன்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு ஆண் நபரை அல்லது ஒரு தெய்வத்தைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவன்",
      "english_word": "he",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "வடிவைப்",
      "pos": "noun",
      "canonical": "வடிவு",
      "definition_ta": "ஒரு பொருளின் அல்லது ஒருவரின் உருவம் அல்லது அமைப்பு.",
      "modern_equivalent": "உருவம்",
      "english_word": "form",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "பொட்டரிப்பைப்போல்",
      "pos": "adverb",
      "canonical": "பொட்டரிப்பு",
      "definition_ta": "முழுமையாக நொறுக்கப்பட்ட அல்லது சிதைக்கப்பட்ட நிலை.",
      "modern_equivalent": "நொறுக்கப்பட்ட",
      "english_word": "like a shattered vessel",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "அழியப்பண்ணுகிறீர்;",
      "pos": "verb",
      "canonical": "அழி",
      "definition_ta": "முழுமையாக அழித்தல் அல்லது சிதைத்தல்.",
      "modern_equivalent": "அழிக்கிறீர்",
      "english_word": "you shatter",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "நிச்சயமாக",
      "pos": "adverb",
      "canonical": "நிச்சயமாக",
      "definition_ta": "எந்தவிதமான சந்தேகமும் இல்லாமல் உறுதியாக அல்லது உண்மையாக.",
      "modern_equivalent": "உண்மையாக",
      "english_word": "surely",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "எந்த",
      "pos": "adjective",
      "canonical": "எந்த",
      "definition_ta": "எந்தவொரு அல்லது எந்த ஒரு குறிப்பிட்ட பொருளைக் குறிக்கும் சொல்.",
      "modern_equivalent": "எந்த",
      "english_word": "any",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "மனுஷனும்",
      "pos": "noun",
      "canonical": "மனுஷன்",
      "definition_ta": "மனிதன் அல்லது மனித இனத்தைச் சேர்ந்தவர்.",
      "modern_equivalent": "மனிதன்",
      "english_word": "man",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "மாயையே.",
