      "definition_ta": "செவிகொண்டு ஒலியை அல்லது ஒருவரின் பேச்சைக் கவனித்தல்.",
      "modern_equivalent": "கேட்டேன்",
      "english_word": "heard",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "கூப்பிடுதலுக்குச்",
      "pos": "noun",
      "canonical": "கூப்பிடுதல்",
      "definition_ta": "ஒருவரை அழைக்கும் செயல் அல்லது உதவிக்காகக் கூப்பிடும் செய்தி.",
      "modern_equivalent": "அழைப்பு",
      "english_word": "call",
      "source": "llm_single_pass"
    },
    {
      "verse": 12,
      "word": "செவிகொடும்;",
      "pos": "verb",
      "canonical": "செவிகொடு",
      "definition_ta": "ஒருவர் சொல்லும் கருத்தை அல்லது கட்டளையை கவனமாகக் கேட்டு ஏற்றுக்கொள்வது.",
      "modern_equivalent": "கவனி",
      "english_word": "listen",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "கண்ணீருக்கு",
      "pos": "noun",
      "canonical": "கண்ணீர்",
      "definition_ta": "கண்ணிலிருந்து வெளியே வரும் நீர்.",
      "modern_equivalent": "கண்ணீர்",
      "english_word": "tears",
      "source": "llm_single_pass"
    },
    {
      "verse": 12,
      "word": "மவுனமாயிராதேயும்;",
      "pos": "adverb",
      "canonical": "மவுனம்",
      "definition_ta": "பேசாமலோ அல்லது சத்தமில்லாமல் இருக்கும் நிலை.",
      "modern_equivalent": "மௌனமாக",
      "english_word": "silent",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "பிதாக்களெல்லாரையும்போல",
      "pos": "noun",
      "canonical": "பிதா",
      "definition_ta": "தந்தை அல்லது தந்தை போன்ற ஒருவரை அழைக்கும் பெயர்.",
      "modern_equivalent": "தந்தை",
      "english_word": "fathers",
      "source": "llm_single_pass"
    },
    {
      "verse": 12,
      "word": "நானும்",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னை ஒருமையில் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "நானும்",
      "english_word": "I also",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "உமக்குமுன்பாக",
      "pos": "adverb",
      "canonical": "முன்பாக",
      "definition_ta": "ஒருவருடைய முன்னால் அல்லது நேருக்கு நேராக இருக்கும் நிலை.",
      "modern_equivalent": "முன்னால்",
      "english_word": "before",
      "source": "llm_single_pass"
    },
