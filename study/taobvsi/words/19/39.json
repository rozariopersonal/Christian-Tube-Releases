      "canonical": "முன்னே",
      "definition_ta": "ஒரு செயல் நடப்பதற்கு முன்பாக அல்லது அதற்கு முன்னதாக.",
      "modern_equivalent": "முன்னதாக",
      "english_word": "before",
      "source": "llm_single_pass"
    },
    {
      "verse": 13,
      "word": "தேறுதலடையும்படி",
      "pos": "conjunction",
      "canonical": "படி",
      "definition_ta": "ஒரு செயலைச் செய்ய அல்லது ஒரு நிலையை அடைய உதவும் வகையில்.",
      "modern_equivalent": "பொருத்தமாக",
      "english_word": "so that",
      "source": "llm_single_pass"
    },
    {
      "verse": 13,
      "word": "என்னிடத்தில்",
      "pos": "adverb",
      "canonical": "என்னிடத்தில்",
      "definition_ta": "என்னுடைய அருகாமையில் அல்லது என்னிடம்.",
      "modern_equivalent": "என்னிடத்தில்",
      "english_word": "to me",
      "source": "db_0ms"
    },
    {
      "verse": 13,
      "word": "பொறுமையாயிரும்.",
      "pos": "verb",
      "canonical": "இரு",
      "definition_ta": "ஒரு நிலையில் நிலைபெற்று அல்லது தங்கியிருப்பது.",
      "modern_equivalent": "இருக்கிறேன்",
      "english_word": "will remain",
      "source": "llm_single_pass"
    }
  ]
