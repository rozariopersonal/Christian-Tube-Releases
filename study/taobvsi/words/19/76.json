      "canonical": "அமர்",
      "definition_ta": "அமர்ந்தது: ஒரு பொருள் ஒரு இடத்தில் நிலைபெற்று தங்குவது அல்லது ஒரு நிலையை அடைவது.",
      "modern_equivalent": "நிலைபெற்றது",
      "english_word": "stood",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "(சேலா)",
      "pos": "noun",
      "canonical": "சேலா",
      "definition_ta": "ஒரு குறிப்பிட்ட நபரின் பெயர் அல்லது அடையாளப் பெயர்.",
      "modern_equivalent": "சேலா",
      "english_word": "Shelah",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "மனுஷனுடைய",
      "pos": "adjective",
