      "word": "உம்முடைய",
      "pos": "pronoun",
      "canonical": "உம்",
      "definition_ta": "உம்முடைய என்பதைக் குறிக்கும் இரண்டாம் ஒருமை பிரதிப்பெயர்",
      "modern_equivalent": "உம்",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "கண்டிதத்தினால்",
      "pos": "noun",
      "canonical": "கண்டிதம்",
      "definition_ta": "ஒருவரை அல்லது ஒரு பொருளை முழுமையாகக் கட்டுப்படுத்தும் அல்லது தடுத்து நிறுத்தும் வல்லமை.",
      "modern_equivalent": "ஆற்றல், வல்லமை",
      "english_word": "power",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "இரதங்களும்",
      "pos": "noun",
      "canonical": "இரதம்",
      "definition_ta": "இரண்டு சக்கரங்கள் கொண்ட ஒரு வகை வண்டி.",
      "modern_equivalent": "ரதங்கள்",
      "english_word": "chariots",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "குதிரைகளும்",
      "pos": "noun",
      "canonical": "குதிரை",
      "definition_ta": "ஓடுவதற்குப் பயன்படும் ஒரு வகை விலங்கு.",
      "modern_equivalent": "குதிரைகள்",
      "english_word": "horses",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "உறங்கி",
      "pos": "verb",
      "canonical": "உறங்கு",
      "definition_ta": "கண்களை மூடி விழிப்புறையின்றி ஓய்வெடுக்கும் நிலை.",
      "modern_equivalent": "தூங்கினார்கள்",
      "english_word": "fell asleep",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "விழுந்தது.",
      "pos": "verb",
      "canonical": "விழு",
      "definition_ta": "ஒரு பொருள் அல்லது நபர் கீழே விழுதல் அல்லது கீழே விழுந்து விழுதல்.",
      "modern_equivalent": "விழுந்தது",
      "english_word": "down",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நீர்,",
      "pos": "pronoun",
      "canonical": "நீர்",
      "definition_ta": "ஒருவரை மரியாதையுடன் குறிக்கும் இரண்டாம் நபர் பிரதிப்பெயர்.",
      "modern_equivalent": "நீங்கள்",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நீரே,",
      "pos": "pronoun",
      "canonical": "நீ",
      "definition_ta": "ஒருவரை நேரடியாகக் குறிப்பிடும் இரண்டாம் ஒருமைப் பிரதிப்பெயர்.",
      "modern_equivalent": "நீ",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "பயங்கரமானவர்;",
      "pos": "adjective",
      "canonical": "பயங்கரமான",
      "definition_ta": "மிகுந்த அச்சத்தையும் திகிலையும் menimbulkan தன்மை கொண்ட.",
      "modern_equivalent": "அச்சமூட்டும்",
      "english_word": "terrible",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உமது",
      "pos": "pronoun",
      "canonical": "உமது",
      "definition_ta": "தேவன் அல்லது அதிகாரமிக்க ஒருவருடைய சொந்தத்தைக் குறிக்கும் மரியாதையான சொல்.",
      "modern_equivalent": "உமது",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "கோபம்",
      "pos": "noun",
      "canonical": "கோபம்",
      "definition_ta": "ஒருவர் செய்த தவறு அல்லது அநீதி காரணமாக ஏற்படும் கடும் மனவருத்தம் அல்லது怒.",
      "modern_equivalent": "கோபம்",
      "english_word": "wrath",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "மூளும்போது",
      "pos": "verb",
      "canonical": "மூள்",
      "definition_ta": "ஒரு பொருள் அல்லது உணர்வு ஒரு இடத்தில் பரவி நிறைந்து வருதல்.",
      "modern_equivalent": "பரவும்போது",
      "english_word": "overflows",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "உமக்கு",
      "pos": "pronoun",
      "canonical": "உம்",
      "definition_ta": "உங்களுக்கு என்று பொருள்படும் பிரதிப்பெயர்.",
      "modern_equivalent": "உங்களுக்கு",
      "english_word": "to you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "முன்பாக",
      "pos": "adverb",
      "canonical": "முன்பாக",
      "definition_ta": "முன்பாக: ஒரு செயலுக்கு முன்னதாக அல்லது ஒருவரின் முன்னால் உள்ள நிலை.",
      "modern_equivalent": "முன்னால்",
      "english_word": "before",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நிற்பவன்",
      "pos": "noun",
      "canonical": "நிற்ப",
      "definition_ta": "ஒரு இடத்தில் நிலைபெற்று அல்லது முன்னே நின்று இருத்தல்.",
      "modern_equivalent": "நிற்பவன்",
      "english_word": "one who stands",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "யார்?",
      "pos": "pronoun",
      "canonical": "யார்",
      "definition_ta": "ஆதாம் தனது தவறை மறைக்க தேவன் கேட்கும் வினாவிலுள்ள வினாப்பெயர்.",
      "modern_equivalent": "யார்",
      "english_word": "who",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நியாயம்",
      "pos": "noun",
      "canonical": "நியாயம்",
      "definition_ta": "சரியான நீதி அல்லது நேர்மையான ஒழுங்கு.",
      "modern_equivalent": "நீதி",
      "english_word": "justice",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "விசாரிக்கவும்",
      "pos": "verb",
      "canonical": "விசாரி",
      "definition_ta": "ஒரு செய்தியை அல்லது தகவலை அறிந்து கொள்ள விசாரணை செய்தல்.",
      "modern_equivalent": "கேட்க",
      "english_word": "to inquire",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பூமியில்",
      "pos": "noun",
      "canonical": "பூமி",
      "definition_ta": "நாம் வாழும் நிலப்பரப்பு அல்லது உலகம்.",
      "modern_equivalent": "நிலம்",
      "english_word": "earth",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "சிறுமைப்பட்டவர்கள்",
      "pos": "noun",
      "canonical": "சிறுமைப்பட்டவர்",
      "definition_ta": "சமூகத்தில் பலவீனமான நிலையில் உள்ளவர்கள் அல்லது ஒடுக்கப்பட்டவர்கள்.",
      "modern_equivalent": "பலவீனமானவர்கள்",
      "english_word": "the weak",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "யாவரையும்",
      "pos": "pronoun",
      "canonical": "யாவர்",
      "definition_ta": "அனைவரையும் குறிக்கும் பொதுவான பிரதிப்பெயர்.",
      "modern_equivalent": "அனைவரையும்",
      "english_word": "all",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "இரட்சிக்கவும்,",
      "pos": "verb",
      "canonical": "இரட்சி",
      "definition_ta": "ஆபத்திலிருந்து விடுவித்தல் அல்லது காப்பாற்றுதல்.",
      "modern_equivalent": "காப்பாற்றுவது",
      "english_word": "save",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "தேவரீர்",
      "pos": "pronoun",
      "canonical": "அவர்",
      "definition_ta": "தேவனை அல்லது ஒரு குறிப்பிட்ட நபரை ஒருமையில் குறிக்கும் பிரதிபெயர்.",
      "modern_equivalent": "அவர்",
      "english_word": "He",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "எழுந்தருளினபோது,",
      "pos": "verb",
      "canonical": "எழுந்தருளு",
      "definition_ta": "தேவன் ஒரு காரியத்தைச் செய்ய அல்லது ஒரு இடத்திற்கு வர முன்முயன்று வருதல்.",
      "modern_equivalent": "எழுந்தெழுந்தார்",
      "english_word": "arose",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "வானத்திலிருந்து",
      "pos": "noun",
      "canonical": "வானம்",
      "definition_ta": "பரந்து விரிந்த ஆகாயம் அல்லது பரமண்டலம்.",
      "modern_equivalent": "வானத்திலிருந்து",
      "english_word": "from heaven",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "நியாயத்தீர்ப்புக்",
      "pos": "noun",
      "canonical": "நியாயத்தீர்ப்பு",
      "definition_ta": "நீதிமானான அல்லது சரியான தீர்ப்பு; சட்டத்தின்படி வழங்கப்படும் நீதி.",
      "modern_equivalent": "நீதி",
      "english_word": "judgment",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "கேட்கப்பண்ணினீர்;",
      "pos": "verb",
      "canonical": "கேட்க",
      "definition_ta": "ஒரு வினாவை அல்லது ஒரு கோரிக்கையை முன்வைத்து கேட்பது.",
      "modern_equivalent": "கேட்டார்கள்",
      "english_word": "asked",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "பூமி",
      "pos": "noun",
      "canonical": "பூமி",
      "definition_ta": "மனுஷர்கள் வாழும் நிலப்பரப்பு அல்லது உலகம்.",
      "modern_equivalent": "உலகம்",
      "english_word": "earth",
      "source": "db_0ms"
    },
    {
