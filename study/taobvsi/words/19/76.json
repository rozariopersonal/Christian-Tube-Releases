    {
      "verse": 10,
      "word": "கோபம்",
      "pos": "noun",
      "canonical": "கோபம்",
      "definition_ta": "ஒருவர் செய்த தவறு அல்லது அநீதி காரணமாக ஏற்படும் கடும் மனவருத்தம் அல்லது怒.",
      "modern_equivalent": "கோபம்",
      "english_word": "wrath",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "உமது",
      "pos": "pronoun",
      "canonical": "உமது",
      "definition_ta": "தேவன் அல்லது அதிகாரமிக்க ஒருவருடைய சொந்தத்தைக் குறிக்கும் மரியாதையான சொல்.",
      "modern_equivalent": "உமது",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "மகிமையை",
      "pos": "noun",
      "canonical": "மகிமை",
      "definition_ta": "ஒருவருடைய சிறப்பான பெருமை அல்லது தெய்வீகமான பிரகாசம்.",
      "modern_equivalent": "பெருமை, பிரகாசம்",
      "english_word": "glory",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "விளங்கப்பண்ணும்;",
      "pos": "verb",
      "canonical": "விளங்கு",
      "definition_ta": "தெளிவாக அறிவித்தல் அல்லது வெளிப்படுத்துதல்.",
      "modern_equivalent": "தெளிவுபடுத்துவான்",
      "english_word": "make known",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "மிஞ்சுங்கோபத்தை",
      "pos": "noun",
      "canonical": "மிஞ்சுகோபம்",
      "definition_ta": "அதிகமாக அல்லது மிஞ்சியிருக்கும் கோபம்.",
      "modern_equivalent": "அதிக கோபம்",
      "english_word": "excess of wrath",
      "source": "llm_single_pass"
