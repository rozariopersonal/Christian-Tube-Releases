      "definition_ta": "ஒன்றாக இருந்த பொருள் பல துண்டுகளாகப் பரவி விழுதல்.",
      "modern_equivalent": "சிதறிக் கிடக்கிறது",
      "english_word": "scattered",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "ஆனாலும்",
      "pos": "adverb",
      "canonical": "ஆனாலும்",
      "definition_ta": "முந்தைய செய்தியைத் தொடர்ந்து ஒரு முரண்பாடான அல்லது கூடுதல் செய்தியை இணைக்கப் பயன்படும் சொல்.",
      "modern_equivalent": "இருந்தாலும்",
      "english_word": "Nevertheless",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "ஆண்டவராகிய",
      "pos": "adjective",
      "canonical": "ஆண்டவர்",
      "definition_ta": "அதிகாரம் அல்லது அதிகாரம் கொண்ட ஆட்சியாளர்.",
      "modern_equivalent": "ஆட்சியாளர்",
      "english_word": "Lord",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கர்த்தாவே,",
      "pos": "noun",
      "canonical": "கர்த்தர்",
      "definition_ta": "ஆளுகை செய்யும் அதிகாரம் கொண்ட ஆண்டவர்",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "Lord",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கண்கள்",
      "pos": "noun",
      "canonical": "கண்",
      "definition_ta": "பார்வைக்கான உறுப்பு அல்லது பார்வை உறுப்பு.",
      "modern_equivalent": "கண்கள்",
      "english_word": "eyes",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உம்மை",
      "pos": "pronoun",
      "canonical": "உம்",
      "definition_ta": "பேசும் நபரை அல்லது கேட்பவரை குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னை",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நோக்கியிருக்கிறது;",
      "pos": "verb",
      "canonical": "நோக்கு",
      "definition_ta": "ஒரு திசையை அல்லது ஒரு பொருளை நோக்கிப் பார்த்தல்.",
      "modern_equivalent": "நோக்கியிருக்கிறது",
      "english_word": "is at hand",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உம்மை",
      "pos": "pronoun",
      "canonical": "உம்",
      "definition_ta": "பேசும் நபரை அல்லது கேட்பவரை குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னை",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
