      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "என்மேல்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "தன்னை அல்லது தன்னைச் சார்ந்த ஒன்றைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "on me",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "ஜெயங்கொள்ளாததினால்,",
      "pos": "verb",
      "canonical": "ஜெயங்கொள்",
      "definition_ta": "ஒருவரை அல்லது ஒரு பொருளை முழுமையாக வென்று அல்லது அடக்கி ஆளுதல்.",
      "modern_equivalent": "வெல்லாததினால்",
      "english_word": "has not prevailed",
      "source": "llm_single_pass"
