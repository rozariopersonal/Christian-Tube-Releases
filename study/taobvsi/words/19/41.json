      "word": "பொல்லாங்கு",
      "pos": "noun",
      "canonical": "பொல்லாங்கு",
      "definition_ta": "தீமை அல்லது தீய செயலை குறிக்கும் சொல்.",
      "modern_equivalent": "தீமை",
      "english_word": "evil",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நினைத்து,",
      "pos": "verb",
      "canonical": "நினை",
      "definition_ta": "மனதில் கொண்டு நினைத்தல் அல்லது கவனித்தல்.",
      "modern_equivalent": "நினைத்து",
      "english_word": "remembered",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "தீராவியாதி",
      "pos": "noun",
      "canonical": "தீராவியாதி",
      "definition_ta": "தீராவியாதி என்னும் ஒரு குறிப்பிட்ட நாட்டின் பெயர்.",
      "modern_equivalent": "தீராவியாதி",
      "english_word": "Philistia",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "அவனைப்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு ஆண்பவரை அல்லது ஒரு பொருளைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவனை",
      "english_word": "him",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பிடித்துக்",
      "pos": "verb",
      "canonical": "பிடி",
      "definition_ta": "ஒரு பொருளை அல்லது ஒருவரை உறுதியாகப் பற்றிக்கொள்வது.",
      "modern_equivalent": "பிடித்து",
      "english_word": "take",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கொண்டது;",
      "pos": "verb",
      "canonical": "கொடு",
      "definition_ta": "ஒரு பொருளை அல்லது நிலையை ஒருவருக்கு அல்லது ஒருவருக்கு மேல் கொடுப்பது அல்லது வருவிக்கும்",
      "modern_equivalent": "வருவித்தது",
      "english_word": "overcame",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "படுக்கையில்",
      "pos": "noun",
      "canonical": "படுக்கை",
      "definition_ta": "தூங்குவதற்கு அல்லது படுப்பதற்குப் பயன்படும் தளம்.",
      "modern_equivalent": "கட்டில்",
      "english_word": "bed",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "கிடக்கிற",
      "pos": "adjective",
      "canonical": "கிட",
      "definition_ta": "ஒரு இடத்தில் நிலைபெற்று இருக்கும் அல்லது அமைந்துள்ள.",
      "modern_equivalent": "இருக்கிற",
      "english_word": "lying",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "அவன்",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "ஒரு ஆண் நபரை அல்லது ஒரு தெய்வத்தைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவன்",
      "english_word": "he",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "இனி",
      "pos": "adverb",
      "canonical": "இனி",
      "definition_ta": "இனிவரும் காலங்களில் அல்லது இனிமேல் என்ற பொருளில் காலத்தைக் குறிக்கிறது.",
      "modern_equivalent": "இனிமேல்",
      "english_word": "anymore",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "எழுந்திருப்பதில்லை",
      "pos": "verb",
      "canonical": "எழுந்திரு",
      "definition_ta": "தூக்கத்தில் இருந்து அல்லது அமர்ந்த நிலையில் இருந்து மேல்நோக்கி எழுந்து நிற்பது.",
      "modern_equivalent": "எழுந்துவிடமாட்டான்",
      "english_word": "rise",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "என்கிறார்கள்.",
      "pos": "verb",
      "canonical": "சொல்",
      "definition_ta": "ஒரு கருத்தை அல்லது பெயரை வாய்மொழியாக வெளிப்படுத்துதல்.",
      "modern_equivalent": "சொல்கிறார்கள்",
      "english_word": "call",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பிராணசிநேகிதனும்,",
      "pos": "noun",
      "canonical": "பிராணசிநேகிதன்",
      "definition_ta": "உயிரைக் காப்பவர் அல்லது உயிரைக் காக்கும் ஒருவரைக் குறிக்கும் சொல்.",
      "modern_equivalent": "உயிரைக் காப்பவர்",
      "english_word": "Preserver of my life",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "நான்",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னைத்தானே குறிக்கும் ஒருமைப் பிரதிப்பெயர்.",
      "modern_equivalent": "நான்",
      "english_word": "I",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "நம்பினவனும்,",
      "pos": "noun",
      "canonical": "நம்பினவன்",
      "definition_ta": "நம்பிக்கையோடு சார்ந்திருக்கும் ஒருவரை அல்லது விசுவாசமுள்ள ஒருவரைக் குறிக்கும் சொல்.",
      "modern_equivalent": "நம்பிக்கையாய் இருப்பவன்",
      "english_word": "Whom I trusted",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "அப்பம்",
      "pos": "noun",
      "canonical": "அப்பம்",
      "definition_ta": "கோதுமை அல்லது பார்சையிலிருந்து தயாரிக்கப்படும் ஒரு வகை உணவு.",
      "modern_equivalent": "ரொட்டி",
      "english_word": "bread",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "புசித்தவனுமாகிய",
      "pos": "adjective",
      "canonical": "புசி",
      "definition_ta": "உணவு அல்லது அப்பத்தைப் புசித்து உண்பவர் என்று பொருள்படும்.",
      "modern_equivalent": "புசித்த",
      "english_word": "Who fed",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "மனுஷனும்,",
      "pos": "noun",
      "canonical": "மனுஷன்",
      "definition_ta": "மனிதன் அல்லது மனித இனத்தைச் சேர்ந்தவர்.",
      "modern_equivalent": "மனிதன்",
      "english_word": "man",
      "source": "db_0ms"
    },
    {
