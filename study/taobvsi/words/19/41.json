      "word": "எனக்கு",
      "pos": "pronoun",
      "canonical": "எனக்கு",
      "definition_ta": "எனக்கு: 'நான்' என்ற பிரதிப்பெயரின் ஒருமைப் பொருள், ஒருவருக்குரிய அல்லது ஒருவருக்குரிய என்பதை உணர்த்துகிறது.",
      "modern_equivalent": "எனக்கு",
      "english_word": "to me",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "இரங்கி,",
      "pos": "verb",
      "canonical": "இரங்கு",
      "definition_ta": "ஒருவருடைய துன்பத்தைக் கண்டு பரிதாபப்பட்டு இரக்கமுடன் நடத்தல்.",
      "modern_equivalent": "இரக்கமாயிருப்பார்",
      "english_word": "have mercy",
      "source": "db_0ms"
