      "modern_equivalent": "ஆதரவளிக்கிறது",
      "english_word": "upholds",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பிராணனை",
      "pos": "noun",
      "canonical": "பிராணன்",
      "definition_ta": "ஒரு உயிரினத்தின் உயிர் அல்லது உயிர்ச்சக்தி.",
      "modern_equivalent": "உயிர்",
      "english_word": "soul",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "அழிக்கத்",
