      "pos": "pronoun",
      "canonical": "என்னை",
      "definition_ta": "பேசும் ஒருவரை அல்லது தன்னைத்தானே குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "என்னை",
      "english_word": "me",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "சூழ்ந்துகொள்ளும்படி",
      "pos": "verb",
      "canonical": "சூழ்ந்து",
      "definition_ta": "ஒருவரைச் சுற்றி அல்லது சூழ்ந்து கொள்ளுவதைக் குறிக்கும் வினைச்சொல்.",
      "modern_equivalent": "சூழ்ந்து கொள்ளும்படி",
      "english_word": "surround",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "செய்வீர்.",
      "pos": "verb",
      "canonical": "செய்",
      "definition_ta": "ஒரு செயலைச் செய்தல் அல்லது ஒரு காரியத்தைச் সম্পাদনித்தல்.",
      "modern_equivalent": "செய்வீர்கள்",
      "english_word": "will do",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "(சேலா)",
      "pos": "noun",
      "canonical": "சேலா",
      "definition_ta": "ஒரு குறிப்பிட்ட நபரின் பெயர் அல்லது அடையாளப் பெயர்.",
      "modern_equivalent": "சேலா",
      "english_word": "Shelah",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நான்",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னைத்தானே குறிக்கும் ஒருமைப் பிரதிப்பெயர்.",
      "modern_equivalent": "நான்",
      "english_word": "I",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உனக்குப்",
      "pos": "pronoun",
      "canonical": "உனக்கு",
      "definition_ta": "உன்னைப் பற்றிக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உனக்கு",
      "english_word": "to you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "போதித்து,",
      "pos": "verb",
      "canonical": "போதி",
      "definition_ta": "கற்பிதம் அல்லது அறிவுரை வழியில் கற்பித்தல்.",
      "modern_equivalent": "கற்பித்து",
      "english_word": "teach",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நீ",
      "pos": "pronoun",
      "canonical": "நீ",
      "definition_ta": "தேவன் ஆதாமுக்கு உரையாடும்போது அவனைக் குறிக்கப் பயன்படுத்திய இரண்டாம் நபர் ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "நீ",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நடக்கவேண்டிய",
      "pos": "adjective",
      "canonical": "நடக்க",
      "definition_ta": "நடப்பதற்கு உரிய அல்லது நடக்க வேண்டிய.",
      "modern_equivalent": "நடக்க வேண்டிய",
      "english_word": "to walk",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "வழியை",
      "pos": "noun",
      "canonical": "வழி",
      "definition_ta": "நடப்பதற்கு அல்லது செல்ல வேண்டிய பாதை அல்லது நெறி.",
      "modern_equivalent": "நெறி",
      "english_word": "way",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உனக்குக்",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "இந்த எச்சரிக்கை சொல்லப்படும் நபரை (மனிதனை) குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உனக்கு",
      "english_word": "you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "காட்டுவேன்;",
      "pos": "verb",
      "canonical": "காட்டு",
      "definition_ta": "ஒருவருக்கு ஒரு பாதையை அல்லது வழியை வெளிப்படுத்துதல் அல்லது காண்பித்தல்.",
      "modern_equivalent": "காட்டுவேன்",
      "english_word": "show",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "உன்மேல்",
      "pos": "particle",
      "canonical": "உன்",
      "definition_ta": "உன்னுடைய அல்லது உன்னோடு தொடர்புடைய என்பதைக் குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "உன்னுடைய",
      "english_word": "upon you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கண்ணை",
      "pos": "noun",
      "canonical": "கண்",
      "definition_ta": "பொருட்களைப் பார்க்க உதவும் முகத்தில் உள்ள உறுப்பு.",
      "modern_equivalent": "கண்",
      "english_word": "eye",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "வைத்து,",
      "pos": "verb",
      "canonical": "வை",
      "definition_ta": "ஒரு பொருளை ஒரு இடத்தில் நிலைநிறுத்துதல் அல்லது ஒரு இடத்தில் பொருத்தி வைத்திருத்தல்.",
      "modern_equivalent": "வைத்து",
      "english_word": "set",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உனக்கு",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "தேவன் ஆதாமின் பாவத்தை நோக்கி அவனிடம் பேசும்போது, அவனுக்கு என்று பொருள்படும் விதத்தில் சொல்லப்பட்டது.",
      "modern_equivalent": "உனக்கு",
      "english_word": "to you",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "ஆலோசனை",
      "pos": "noun",
      "canonical": "ஆலோசனை",
      "definition_ta": "ஒரு செயலைச் செய்வதற்கு முன் பெறப்படும் அறிவு அல்லது வழிகாட்டுதல்.",
      "modern_equivalent": "வழிநடத்துதல்",
      "english_word": "counsel",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "சொல்லுவேன்.",
      "pos": "verb",
      "canonical": "சொல்",
      "definition_ta": "ஒரு செய்தியை அல்லது தகவலை வாய்மொழியாக வெளிப்படுத்துதல்.",
      "modern_equivalent": "சொல்வேன்",
      "english_word": "say",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "வாரினாலும்",
      "pos": "noun",
      "canonical": "வார்",
      "definition_ta": "விலங்குகளைக் கட்டுவதற்குப் பயன்படும் நீண்ட கயிறு.",
      "modern_equivalent": "கயிறு",
      "english_word": "bridle",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "கடிவாளத்தினாலும்",
      "pos": "noun",
      "canonical": "கடிவாளம்",
      "definition_ta": "குதிரையின் வாயில் உள்ளே வைத்து அதன் இயக்கத்தைக் கட்டுப்படுத்தும் கருவி.",
      "modern_equivalent": "கடிவாளம்",
      "english_word": "bit",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "வாய்",
      "pos": "noun",
      "canonical": "வாய்",
      "definition_ta": "ஒரு பொருளின் நுழைவாய்ப்பு அல்லது திறந்த பகுதி.",
      "modern_equivalent": "வாய்",
      "english_word": "mouth",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கட்டப்பட்டாலொழிய,",
      "pos": "verb",
      "canonical": "கட்டு",
      "definition_ta": "ஒரு பொருளை அல்லது ஒருவரை நகரவிடாமல் பிணைத்து வைத்தல்.",
      "modern_equivalent": "கட்டுதல்",
      "english_word": "bridled",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "உன்",
      "pos": "pronoun",
      "canonical": "உன்",
      "definition_ta": "உன்னுடைய அல்லது உன்னுடைய சொந்தமான என்பதைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உன்னுடைய",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கிட்டச்",
      "pos": "adverb",
      "canonical": "கிட்ட",
      "definition_ta": "மிகவும் அருகாமையில் அல்லது நெருக்கமாக",
      "modern_equivalent": "அருகில்",
      "english_word": "near",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "சேராத",
      "pos": "adjective",
      "canonical": "சேரா",
      "definition_ta": "ஒருவருக்கு உரியதாகவோ அல்லது ஒருவருக்குக் கொடுக்கப்பட்டதாகவோ இல்லாத.",
      "modern_equivalent": "சேராத",
      "english_word": "unbridled",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "புத்தியில்லாக்",
      "pos": "noun",
      "canonical": "புத்தி",
      "definition_ta": "ஒருவர் சிந்திக்கும் திறன் அல்லது பகுத்தறியும் அறிவு.",
      "modern_equivalent": "அறிவு",
      "english_word": "understanding",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "குதிரையைப்போலவும்",
      "pos": "noun",
      "canonical": "குதிரை",
      "definition_ta": "வேகமாக ஓடும் ஒரு வகை விலங்கு.",
      "modern_equivalent": "குதிரை",
      "english_word": "horse",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "கோவேறு",
      "pos": "adjective",
      "canonical": "கோவேறு",
      "definition_ta": "கோவேறு நிறமுடைய அல்லது பழுப்பு நிறமுடைய.",
      "modern_equivalent": "பழுப்பு நிற",
      "english_word": "some",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கழுதையைப்போலவும்",
      "pos": "noun",
      "canonical": "கழுதை",
      "definition_ta": "ஒரு வகை கடினமான மற்றும் அதிக சுமை தாங்கும் விலங்கு.",
      "modern_equivalent": "கழுதை",
      "english_word": "donkey",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "இருக்கவேண்டாம்.",
      "pos": "verb",
      "canonical": "இரு",
      "definition_ta": "ஒரு இடத்தில் நிலைபெற்று அல்லது தங்கியிருப்பது.",
      "modern_equivalent": "இருக்கக்கூடாது",
      "english_word": "should not be",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "துன்மார்க்கனுக்கு",
      "pos": "noun",
      "canonical": "துன்மார்க்கன்",
      "definition_ta": "தீமை செய்கிற அல்லது தேவனுக்கு கீழ்ப்படியாத ஒரு நபர்.",
      "modern_equivalent": "பாவம் செய்பவன்",
      "english_word": "wicked man",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "அநேக",
      "pos": "adjective",
      "canonical": "அநேகம்",
      "definition_ta": "எண்ணற்ற அல்லது அதிகமான எண்ணிக்கையைக் குறிக்கும்.",
      "modern_equivalent": "பல",
      "english_word": "many",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "வேதனைகளுண்டு;",
      "pos": "noun",
      "canonical": "வேதனை",
      "definition_ta": "உடல் அல்லது மனதிற்கு ஏற்படும் துன்பம் அல்லது வலி.",
      "modern_equivalent": "துன்பம்",
      "english_word": "afflictions",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "கர்த்தரை",
      "pos": "noun",
      "canonical": "கர்த்தர்",
      "definition_ta": "கர்த்தர்: ஆளுகை செய்யும் அதிகாரம் கொண்ட இறைவன் அல்லது ஆண்டவர்.",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "the LORD",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "நம்பியிருக்கிறவனையோ",
      "pos": "pronoun",
      "canonical": "நம்பியிருக்கிறவன்",
      "definition_ta": "தேவனை முழுமையாக நம்பி சார்ந்திருக்கும் ஒரு நபர்.",
      "modern_equivalent": "நம்புகிறவன்",
      "english_word": "one who trusts",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "கிருபை",
      "pos": "noun",
      "canonical": "கிருபை",
      "definition_ta": "தேவனுடைய தயவு அல்லது undeserved favor; ஒருவருக்கு undeserved grace அல்லது அருள் கிடைப்பதைக் குறிக்கும்.",
      "modern_equivalent": "அருள்",
      "english_word": "grace",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "சூழ்ந்து",
      "pos": "verb",
      "canonical": "சூழ்",
      "definition_ta": "ஒரு பொருளை அல்லது இடத்தை முழுமையாகச் சுற்றி வருவது.",
      "modern_equivalent": "சுற்றி",
      "english_word": "besiege",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "கொள்ளும்.",
      "pos": "verb",
      "canonical": "கொள்ள",
      "definition_ta": "ஒரு செய்தியை அல்லது உண்மையை அறிந்துகொள்ளுதல்.",
      "modern_equivalent": "அறிந்துகொள்ளும்",
      "english_word": "will know",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "நீதிமான்களே,",
      "pos": "noun",
      "canonical": "நீதிமான்",
      "definition_ta": "தேவனுடைய கட்டளைகளுக்குக் கீழ்ப்படிந்து நடக்கும் நீதிமானான மனிதன்.",
      "modern_equivalent": "நீதிமான்கள்",
      "english_word": "righteous",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "கர்த்தருக்குள்",
      "pos": "particle",
      "canonical": "கர்த்தர்",
      "definition_ta": "ஆண்டவராகிய தேவன்.",
      "modern_equivalent": "கர்த்தருக்குள்",
      "english_word": "in the Lord",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "மகிழ்ந்து",
      "pos": "verb",
      "canonical": "மகிழ்",
