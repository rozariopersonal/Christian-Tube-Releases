    },
    {
      "verse": 13,
      "word": "பலப்படுத்தி,",
      "pos": "verb",
      "canonical": "பலப்படுத்து",
      "definition_ta": "அதிகப்படுத்துதல் அல்லது பெருக்கச்செய்தல்.",
