      "word": "உயர்த்துகிறார்;",
      "pos": "verb",
      "canonical": "உயர்த்து",
      "definition_ta": "ஒருவரை உயர்ந்த நிலைக்கு அல்லது உயர்வான இடத்திற்கு கொண்டு வருதல்.",
      "modern_equivalent": "மேம்படுத்துகிறார்",
      "english_word": "lifts up",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "துன்மார்க்கரைத்",
      "pos": "noun",
      "canonical": "துன்மார்க்கன்",
      "definition_ta": "தீமை செய்யும் அல்லது ஒழுக்கமற்ற வழியில் நடக்கும் நபர்.",
      "modern_equivalent": "தீயவர்கள்",
      "english_word": "the wicked",
      "source": "llm_single_pass"
    },
    {
      "verse": 6,
      "word": "தரைமட்டும்",
      "pos": "adverb",
      "canonical": "தரை",
      "definition_ta": "பாதையில் நடக்கும் அல்லது தரைப்பகுதி.",
      "modern_equivalent": "தரைக்கு",
      "english_word": "to the ground",
      "source": "db_0ms"
    },
    {
      "verse": 6,
      "word": "தாழ்த்துகிறார்.",
      "pos": "verb",
      "canonical": "தாழ்",
      "definition_ta": "தன்னைக் குறைத்துக் கொள்ளுதல் அல்லது பணிவாக இருத்தல்.",
      "modern_equivalent": "பணிந்து கொள்கிறார்",
      "english_word": "humbles",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "கர்த்தரைத்",
      "pos": "noun",
      "canonical": "கர்த்தர்",
      "definition_ta": "ஆண்டவராக அல்லது இறைவனாக வணங்கப்படும் பரம தேவன்.",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "the LORD",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "துதியுடன்",
      "pos": "adverb",
      "canonical": "துதி",
      "definition_ta": "பெருமை அல்லது போற்றுதல் disertai",
      "modern_equivalent": "துதியுடன்",
      "english_word": "with praise",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "பாடிக்கொண்டாடுங்கள்;",
      "pos": "verb",
      "canonical": "பாடு",
      "definition_ta": "இசை அல்லது பாடலாகப் பாடுதல்",
      "modern_equivalent": "பாடிக்கொண்டாடுங்கள்",
      "english_word": "sing",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "நம்முடைய",
      "pos": "pronoun",
      "canonical": "நாம்",
      "definition_ta": "பேசும் நபர் மற்றும் அவரோடு இணைந்திருக்கும் குழுவினரின் உடைமையை குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "நம்முடைய",
      "english_word": "our",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "தேவனைச்",
      "pos": "noun",
      "canonical": "தேவன்",
      "definition_ta": "சர்வ வல்லமையுள்ள படைத்தவர்",
      "modern_equivalent": "கடவுள்",
      "english_word": "God",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "சுரமண்டலத்தால்",
      "pos": "noun",
      "canonical": "சுரமண்டலம்",
      "definition_ta": "தேவனுடைய மகிமையை வெளிப்படுத்தும் தெய்வீகமான இசைக்கருவி.",
      "modern_equivalent": "சுருதி",
      "english_word": "heavenly host",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "கீர்த்தனம்",
      "pos": "noun",
      "canonical": "கீர்த்தனம்",
      "definition_ta": "ஒருவரைப் போற்றிப் பாடுவதற்காகச் செய்யப்படும் இசைப்படைப்பு அல்லது பாடல்.",
      "modern_equivalent": "பாடல்",
      "english_word": "praise",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "பண்ணுங்கள்.",
      "pos": "verb",
      "canonical": "செய்",
      "definition_ta": "ஒரு செயலைச் செய்தல் அல்லது ஒரு காரியத்தைச் செய்து முடித்தல்.",
      "modern_equivalent": "செய்யுங்கள்",
      "english_word": "do",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "அவர்",
      "pos": "pronoun",
      "canonical": "அவர்",
      "definition_ta": "தேவனாகிய கர்த்தரை இந்த வாக்கியத்தில் குறிக்கிறது.",
      "modern_equivalent": "அவர்",
      "english_word": "He",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "வானத்தை",
      "pos": "noun",
      "canonical": "வானம்",
      "definition_ta": "பூமியின் மேலே உள்ள ஆகாயம் அல்லது பரமண்டலத்தைக் குறிக்கும் பெயர்ச்சொல்.",
      "modern_equivalent": "வானம்",
      "english_word": "heaven",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "மேகங்களால்",
      "pos": "noun",
      "canonical": "மேகம்",
      "definition_ta": "வானத்தில் உள்ள நீராவி அல்லது நீர் கொண்ட மேகக்கூட்டம்.",
      "modern_equivalent": "மேகங்கள்",
      "english_word": "clouds",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "மூடி,",
      "pos": "verb",
      "canonical": "மூடு",
      "definition_ta": "ஒரு பொருளின் மேல் ஒரு பொருளை வைத்து மறைக்கும் அல்லது மூடும் செயல்.",
      "modern_equivalent": "மூடும்",
      "english_word": "cover",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பூமிக்கு",
      "pos": "noun",
      "canonical": "பூமி",
      "definition_ta": "மனிதர்கள் வாழும் நிலப்பரப்பு அல்லது உலகம்.",
      "modern_equivalent": "பூமி",
      "english_word": "earth",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "மழையை",
      "pos": "noun",
      "canonical": "மழை",
      "definition_ta": "வானத்திலிருந்து பூமியை நோக்கி விழும் நீர்.",
      "modern_equivalent": "மழை",
      "english_word": "rain",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "ஆயத்தப்படுத்தி,",
      "pos": "verb",
      "canonical": "ஆயத்தம்",
      "definition_ta": "ஒரு காரியத்திற்காகத் தேவையான முன்னேற்பாடு செய்தல் அல்லது தயார் செய்தல்.",
      "modern_equivalent": "தயார் செய்தான்",
      "english_word": "prepared",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "மலைகளில்",
      "pos": "noun",
      "canonical": "மலை",
      "definition_ta": "பூமியின் மேல்பகுதியில் உள்ள உயர்ந்த நிலப்பகுதி.",
      "modern_equivalent": "மலைகள்",
      "english_word": "mountains",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "புல்லை",
      "pos": "noun",
      "canonical": "புல்",
      "definition_ta": "நிலத்தில் வளரும் சிறிய பச்சை நிறக் கனி அல்லது செடி.",
      "modern_equivalent": "புல்",
      "english_word": "grass",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "முளைப்பிக்கிறார்.",
      "pos": "verb",
      "canonical": "முளை",
      "definition_ta": "விதைகளிலிருந்து செடி அல்லது தாவரம் வளர்ந்து வருதல்.",
      "modern_equivalent": "முளைக்கச் செய்கிறார்",
      "english_word": "makes [them] grow",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "அவர்",
      "pos": "pronoun",
      "canonical": "அவர்",
      "definition_ta": "தேவனாகிய கர்த்தரை இந்த வாக்கியத்தில் குறிக்கிறது.",
      "modern_equivalent": "அவர்",
      "english_word": "He",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "மிருகஜீவன்களுக்கும்",
      "pos": "noun",
      "canonical": "மிருகஜீவன்",
      "definition_ta": "பூமியில் வாழும் விலங்குகள் அல்லது கால்நடைகள்.",
      "modern_equivalent": "விலங்குகள்",
      "english_word": "beasts",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கூப்பிடுகிற",
      "pos": "verb",
      "canonical": "கூப்பிடு",
      "definition_ta": "ஒருவரை அழைக்க அல்லது ஒரு காரியத்தை கோர அழைத்தல்.",
      "modern_equivalent": "அழைக்கும்",
      "english_word": "request",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "காக்கைக்",
      "pos": "adjective",
      "canonical": "காக்கா",
      "definition_ta": "கருப்பு நிறத்தில் உள்ள ஒரு வகை பறவை.",
      "modern_equivalent": "காக்கா",
      "english_word": "raven",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "குஞ்சுகளுக்கும்",
      "pos": "noun",
      "canonical": "குஞ்சு",
      "definition_ta": "பிறந்த புதிதான அல்லது சிறிய பறவை அல்லது விலங்கு.",
      "modern_equivalent": "குஞ்சு",
      "english_word": "fledglings",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "ஆகாரங்கொடுக்கிறார்.",
      "pos": "verb",
      "canonical": "ஆகாரங்கொடு",
      "definition_ta": "உணவளித்தல் அல்லது உணவு வழங்குதல்.",
      "modern_equivalent": "உணவு கொடுக்கிறார்",
      "english_word": "gives food",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "அவர்",
      "pos": "pronoun",
      "canonical": "அவர்",
      "definition_ta": "தேவனாகிய கர்த்தரை இந்த வாக்கியத்தில் குறிக்கிறது.",
      "modern_equivalent": "அவர்",
      "english_word": "He",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "குதிரையின்",
      "pos": "noun",
      "canonical": "குதிரை",
      "definition_ta": "வேகமாக ஓடும் ஒரு வகை பெரிய விலங்கு.",
      "modern_equivalent": "குதிரை",
      "english_word": "horse",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "பலத்தில்",
      "pos": "noun",
      "canonical": "பலம்",
      "definition_ta": "ஒருவர் அல்லது ஒரு பொருள் கொண்டுள்ள உடல் வலிமை அல்லது ஆற்றல்.",
      "modern_equivalent": "வலிமை",
      "english_word": "strength",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "விருப்பமாயிரார்;",
      "pos": "adjective",
      "canonical": "விருப்பம்",
      "definition_ta": "விருப்பமான அல்லது விருப்பமான நிலையில் உள்ள.",
      "modern_equivalent": "விருப்பமான",
      "english_word": "willing",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "வீரனுடைய",
      "pos": "noun",
      "canonical": "வீரன்",
      "definition_ta": "போரில் போர் புரியும் தைரியமான மனிதன்.",
      "modern_equivalent": "வீரர்",
      "english_word": "mighty man",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "கால்களில்",
      "pos": "noun",
      "canonical": "கால்",
      "definition_ta": "மனித உடலின் ஒரு உறுப்பு, நடப்பதற்குப் பயன்படும் பகுதி.",
      "modern_equivalent": "பாதம்",
      "english_word": "feet",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "பிரியப்படார்.",
      "pos": "verb",
      "canonical": "பிரிய",
      "definition_ta": "பிரிந்து செல்லுதல் அல்லது விலகிச் செல்லுதல்.",
      "modern_equivalent": "பிரிந்துசெல்லார்",
      "english_word": "be separated",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "தமக்குப்",
      "pos": "pronoun",
      "canonical": "தமக்கு",
      "definition_ta": "தன்னிடத்திற்கு அல்லது தனக்கு என்று பொருள்படும் பிரதிப்பெயர்.",
      "modern_equivalent": "தமக்கு",
      "english_word": "himself",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "பயந்து,",
      "pos": "verb",
      "canonical": "பய",
      "definition_ta": "அச்சம் அல்லது ஒருவனால் ஏற்படும் மனதின் கலக்கம்.",
      "modern_equivalent": "பயந்தேன்",
      "english_word": "feared",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "தமது",
      "pos": "pronoun",
      "canonical": "தமது",
      "definition_ta": "அவருடைய அல்லது அவருடைய என்று பொருள்படும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவருடைய",
      "english_word": "his",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "கிருபைக்குக்",
      "pos": "noun",
      "canonical": "கிருபை",
      "definition_ta": "தேவனுடைய தயவு அல்லது undeserved favor",
      "modern_equivalent": "அருள்",
      "english_word": "mercy",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "காத்திருக்கிறவர்கள்மேல்",
      "pos": "noun",
      "canonical": "காத்திருப்பவர்",
      "definition_ta": "ஒரு பொருளை அல்லது ஒருவரின் உதவியை எதிர்பார்த்து காத்திருக்கும் நபர்.",
      "modern_equivalent": "காத்திருப்பவர்கள் மீது",
      "english_word": "those who wait",
      "source": "llm_single_pass"
    },
    {
      "verse": 11,
      "word": "கர்த்தர்",
      "pos": "particle",
      "canonical": "கர்த்தர்",
      "definition_ta": "சர்வ வல்லமையுள்ள இறைவனாகிய ஆண்டவரை குறிக்கும்.",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "LORD",
      "source": "db_disambiguated"
    },
    {
      "verse": 11,
      "word": "பிரியமாயிருக்கிறார்.",
      "pos": "verb",
      "canonical": "பிரியம்",
      "definition_ta": "ஒருவர் மீது மிகுந்த அன்பு அல்லது விருப்பம் கொண்டிருப்பது.",
      "modern_equivalent": "பிடித்திருக்கிறார்",
      "english_word": "is well spoken of",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "எருசலேமே,",
      "pos": "noun",
      "canonical": "எருசலேம்",
      "definition_ta": "யூதர்களின் புனிதமான நகரமான எருசலேம்.",
      "modern_equivalent": "எருசலேம்",
      "english_word": "Jerusalem",
      "source": "db_0ms"
    },
    {
