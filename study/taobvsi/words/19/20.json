      "canonical": "கர்த்தர்",
      "definition_ta": "ஆண்டவராகிய தேவன் அல்லது இறைவனின் அதிகாரப்பூர்வமான பெயர்.",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "LORD",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நாமத்தைக்குறித்தே",
      "pos": "noun",
      "canonical": "பெயர்",
      "definition_ta": "ஒரு நபர் அல்லது ஒரு பொருளை அடையாளம் காட்டும் சொல்.",
      "modern_equivalent": "பெயர்",
      "english_word": "name",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "மேன்மைபாராட்டுவோம்.",
      "pos": "verb",
      "canonical": "பாராட்டு",
      "definition_ta": "ஒரு பொருளை அல்லது ஒருவரை உயர்வாகக் கருதி மதிப்பிடுதல்.",
      "modern_equivalent": "மேன்மைபாராட்டுவோம்",
      "english_word": "boast",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "அவர்கள்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "தேவன் மற்றும் அவருடைய வார்த்தையைச் சித்தமாகக் குறிக்கும் பன்மை பிரதிபெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "They",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "முறிந்து",
      "pos": "adverb",
      "canonical": "முறிந்து",
      "definition_ta": "முழுவேகத்துடன் அல்லது தடையின்றி விரைவாகச் செயல்படும் வினையடை.",
      "modern_equivalent": "வேகமாக",
      "english_word": "running",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "விழுந்தார்கள்;",
      "pos": "verb",
      "canonical": "விழு",
      "definition_ta": "ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு கீழே விழுதல் அல்லது விழுந்து விழுந்து விழுதல்.",
      "modern_equivalent": "விழுந்தார்கள்",
      "english_word": "fell",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நாங்களோ",
      "pos": "pronoun",
      "canonical": "நாங்கள்",
      "definition_ta": "நாங்கள் என்ற பிரதிப்பெயர், ஒரு குழு அல்லது கூட்டத்தைச் சுட்டிக்காட்டுகிறது.",
      "modern_equivalent": "நாங்கள்",
      "english_word": "But we",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "எழுந்து",
      "pos": "verb",
      "canonical": "எழு",
      "definition_ta": "ஒரு இடத்தில் இருந்து மற்றொரு இடத்திற்கு நகருதல் அல்லது எழுந்து立ちதல்.",
      "modern_equivalent": "எழுந்து",
      "english_word": "Arise",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நிமிர்ந்து",
      "pos": "verb",
      "canonical": "நிமிர்",
      "definition_ta": "நேராக அல்லது மேல்நோக்கி நிலைநிற்பது.",
      "modern_equivalent": "நின்றது",
      "english_word": "stood",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நிற்கிறோம்.",
      "pos": "verb",
      "canonical": "நில்",
      "definition_ta": "ஒரு இடத்தில் நிலைபெற்று அல்லது உறுதியாக இருப்பதை குறிக்கும் வினைச்சொல்.",
      "modern_equivalent": "நிற்கிறோம்",
      "english_word": "stand",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "கர்த்தாவே,",
      "pos": "noun",
      "canonical": "கர்த்தர்",
      "definition_ta": "ஆளுகை செய்யும் அதிகாரம் கொண்ட ஆண்டவர்",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "Lord",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "இரட்சியும்;",
      "pos": "verb",
      "canonical": "இரட்சி",
      "definition_ta": "ஆபத்திலிருந்து விடுவித்தல் அல்லது ஒருவரைப் பாதுகாத்தல்.",
      "modern_equivalent": "விடுவிக்கவும்",
      "english_word": "deliver",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "நாங்கள்",
      "pos": "pronoun",
      "canonical": "நாங்கள்",
      "definition_ta": "அங்கே பேசிக்கொண்டிருந்த ஆதாமுக்கும் ஏவாளுக்கும் இடையிலான கூட்டுப் பிரதிநிதித்துவத்தைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "நாங்கள்",
      "english_word": "we",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கூப்பிடுகிற",
      "pos": "verb",
      "canonical": "கூப்பிடு",
      "definition_ta": "ஒருவரை அழைக்க அல்லது ஒரு காரியத்தை கோர அழைத்தல்.",
      "modern_equivalent": "அழைக்கும்",
      "english_word": "request",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "நாளிலே",
      "pos": "noun",
      "canonical": "நாள்",
      "definition_ta": "சூரியன் உதிக்கும் முதல் நேரத்திலிருந்து அடுத்த நாள் வரை உள்ள கால அளவு.",
      "modern_equivalent": "தினம்",
      "english_word": "day",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "ராஜா",
      "pos": "noun",
      "canonical": "ராஜா",
      "definition_ta": "ஒரு நாட்டின் அல்லது ஒரு கூட்டத்தின் தலைவன் அல்லது ஆட்சியாளர்.",
      "modern_equivalent": "அரசன்",
      "english_word": "king",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "எங்களுக்குச்",
      "pos": "pronoun",
      "canonical": "எங்களுக்கு",
      "definition_ta": "எங்கள் என்ற சொல்லின் வேற்றுமை உருபான பிரதிப்பெயர்.",
      "modern_equivalent": "எங்களுக்கு",
      "english_word": "to us",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "செவிகொடுப்பாராக.",
      "pos": "verb",
      "canonical": "செவிகொடு",
      "definition_ta": "ஒருவருடைய வார்த்தைகளையோ அல்லது விண்ணப்பத்தையோ கவனித்து அதன்படி நடக்கும் செயலைச் செய்தல்.",
      "modern_equivalent": "கவனிப்பாராக",
      "english_word": "hear",
      "source": "llm_single_pass"
    }
  ]
}