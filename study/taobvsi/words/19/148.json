      "word": "நாமத்தைத்",
      "pos": "noun",
      "canonical": "நாமம்",
      "definition_ta": "ஒருவருடைய பெயர் அல்லது அடையாளம்.",
      "modern_equivalent": "பெயர்",
      "english_word": "name",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "துதிக்கக்கடவது;",
      "pos": "verb",
      "canonical": "துதிக்க",
      "definition_ta": "ஒரு பொருளை அல்லது ஒருவரை ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு நகர்த்துதல் அல்லது கொண்டு செல்லுதல்.",
      "modern_equivalent": "நகர்த்துதல்",
      "english_word": "carry",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "அவர்",
      "pos": "pronoun",
      "canonical": "அவர்",
      "definition_ta": "தேவனாகிய கர்த்தரை இந்த வாக்கியத்தில் குறிக்கிறது.",
      "modern_equivalent": "அவர்",
      "english_word": "He",
      "source": "db_0ms"
    },
    {
