      "word": "எம்மாத்திரம்",
      "pos": "adverb",
      "canonical": "எம்மாத்திரம்",
      "definition_ta": "எவ்வளவு அல்லது எந்த அளவிற்கு என்ற பொருளைக் குறிக்கும் வினையடை.",
      "modern_equivalent": "எவ்வளவு",
      "english_word": "how much",
      "source": "db_0ms"
    },
    {
      "verse": 4,
      "word": "என்கிறேன்.",
      "pos": "verb",
      "canonical": "சொல்",
      "definition_ta": "ஒரு கருத்தை அல்லது செய்தியை மற்றவர்களுக்கு அறிவித்தல் அல்லது கூறுதல்.",
      "modern_equivalent": "சொல்கிறேன்",
      "english_word": "say",
      "source": "db_0ms"
    },
    {
      "verse": 5,
      "word": "நீர்",
      "pos": "pronoun",
      "canonical": "நீர்",
      "definition_ta": "ஒருவரை மரியாதையுடன் குறிக்கும் இரண்டாம் நபர் பிரதிப்பெயர்.",
      "modern_equivalent": "நீங்கள்",
