      "canonical": "நான்",
      "definition_ta": "பேசும் பெண்ணான ஸ்திரீயானவளைப் பற்றிய பிரதிபெயரைக் குறிக்கிறது.",
      "modern_equivalent": "என்னை",
      "english_word": "me",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "வளைந்துகொள்ளுகிறவர்களுடைய",
      "pos": "adjective",
      "canonical": "வளைந்து",
      "definition_ta": "நேர்மையற்ற அல்லது வஞ்சகமான செயல்களைச் செய்யும்",
      "modern_equivalent": "வஞ்சகமான",
      "english_word": "perverse",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "உதடுகளின்",
      "pos": "noun",
      "canonical": "உதடு",
      "definition_ta": "வாய் உள்ளே உள்ள இரண்டு தசைப் பகுதிகள்.",
      "modern_equivalent": "உதடுகள்",
      "english_word": "lips",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "தீவினைகள்",
      "pos": "noun",
      "canonical": "தீவினை",
      "definition_ta": "தீய அல்லது தீய விளைவுகளை ஏற்படுத்தும் செயல்கள்",
      "modern_equivalent": "தீவினை",
      "english_word": "wickedness",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "அவர்கள்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "தேவன் மற்றும் அவருடைய வார்த்தையைச் சித்தமாகக் குறிக்கும் பன்மை பிரதிபெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "They",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "தலைகளையே",
