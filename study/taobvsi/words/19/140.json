      "canonical": "பொல்லாப்பு",
      "definition_ta": "தீமை அல்லது கெட்ட விளைவு ஏற்படும் நிலை.",
      "modern_equivalent": "தீமை",
      "english_word": "evil",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "அவனை",
      "pos": "pronoun",
      "canonical": "அவன்",
      "definition_ta": "பாவம் செய்த அல்லது தீமை செய்த ஒருவரைப் பற்றிக் குறிக்கிறது.",
      "modern_equivalent": "அவனை",
      "english_word": "him",
      "source": "db_0ms"
    },
    {
      "verse": 11,
      "word": "வேட்டையாடும்.",
      "pos": "verb",
      "canonical": "வேட்டையாடு",
      "definition_ta": "ஒருவரைப் பிடிப்பதற்காகத் துரத்திச் சென்றுப் பிடிக்கும் செயல்.",
      "modern_equivalent": "துரத்திப்பிடிக்கும்",
      "english_word": "hunt",
      "source": "llm_single_pass"
    },
    {
      "verse": 12,
      "word": "சிறுமையானவனின்",
