      "definition_ta": "சட்டப்படி தீர்மானிக்கப்பட வேண்டிய விவாதம் அல்லது வழக்கு.",
      "modern_equivalent": "வழக்கு",
      "english_word": "law",
      "source": "db_0ms"
    },
    {
      "verse": 12,
      "word": "எளியவர்களின்",
      "pos": "adjective",
      "canonical": "எளிய",
      "definition_ta": "அறிவு அல்லது ஆற்றல் குறைந்த நிலையில் உள்ளவர்கள்.",
      "modern_equivalent": "ஏழை, அறிவில்லாத",
      "english_word": "the poor",
      "source": "db_0ms"
    },
    {
