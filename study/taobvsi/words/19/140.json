      "word": "மூடுவதாக.",
      "pos": "verb",
      "canonical": "மூடு",
      "definition_ta": "ஒரு பொருளை அல்லது இடத்தை மறைத்தல் அல்லது மூடுதல்",
      "modern_equivalent": "மூடு",
      "english_word": "cover",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "நெருப்புத்தழல்",
      "pos": "noun",
      "canonical": "நெருப்புத்தழல்",
      "definition_ta": "தீயின் சுடர் அல்லது எரியும் தழல்.",
      "modern_equivalent": "நெருப்புச் சுடர்",
      "english_word": "flame of fire",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "அவர்கள்மேல்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "பல நபர்களைக் குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "them",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "விழுவதாக;",
      "pos": "verb",
      "canonical": "விழு",
      "definition_ta": "மேலிருந்து கீழே விழுதல் அல்லது விழுதல்.",
      "modern_equivalent": "விழுவார்கள்",
      "english_word": "fall",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "அக்கினியிலும்,",
      "pos": "noun",
      "canonical": "அக்கினி",
      "definition_ta": "நெருப்பு அல்லது எரியும் வெப்பம்.",
      "modern_equivalent": "நெருப்பு",
      "english_word": "fire",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "அவர்கள்",
      "pos": "pronoun",
      "canonical": "அவர்கள்",
      "definition_ta": "தேவன் மற்றும் அவருடைய வார்த்தையைச் சித்தமாகக் குறிக்கும் பன்மை பிரதிபெயர்.",
      "modern_equivalent": "அவர்கள்",
      "english_word": "They",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "எழுந்திருக்கக்கூடாத",
      "pos": "adjective",
      "canonical": "எழுந்திருக்கக்கூடாத",
      "definition_ta": "எழுந்து நிற்க முடியாத அல்லது எழும்ப முடியாத.",
      "modern_equivalent": "எழுந்து நிற்க முடியாத",
      "english_word": "unable to rise",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "படுகுழிகளிலும்",
      "pos": "noun",
      "canonical": "படுகுழி",
      "definition_ta": "ஆழமான மற்றும் ஆபத்தான குழி அல்லது பள்ளம்.",
