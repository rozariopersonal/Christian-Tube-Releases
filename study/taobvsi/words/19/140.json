      "pos": "pronoun",
      "canonical": "தன்னை",
      "definition_ta": "தன்னையே குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "தன்னை",
      "english_word": "herself",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "உயர்த்தாதபடி",
      "pos": "verb",
      "canonical": "உயர்த்து",
      "definition_ta": "ஒருவரை அல்லது ஒரு பொருளை உயர்ந்த நிலைக்குக் கொண்டு வருதல்.",
      "modern_equivalent": "உயர்த்தாதபடி",
      "english_word": "exalt",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "அவனுடைய",
      "pos": "pronoun",
      "canonical": "அவனுடைய",
      "definition_ta": "ஆதாம் அல்லது குறிப்பிட்ட ஒரு நபரைச் சுட்டிக்காட்டும் ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "அவனுடைய",
      "english_word": "his",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "யோசனையை",
      "pos": "noun",
      "canonical": "யோசனை",
      "definition_ta": "ஒரு செயலைச் செய்ய அல்லது செய்யாமல் இருக்க மனதில் தோன்றும் எண்ணம்.",
      "modern_equivalent": "எண்ணம்",
      "english_word": "thought",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "நடந்தேறவொட்டாதேயும்.",
      "pos": "verb",
      "canonical": "நடந்து",
      "definition_ta": "ஒரு காரியம் அல்லது திட்டம் நிறைவேறுதல் அல்லது நிகழ்தல்.",
      "modern_equivalent": "நிறைவேறாதபடி",
      "english_word": "accomplish",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "(சேலா)",
      "pos": "noun",
      "canonical": "சேலா",
      "definition_ta": "ஒரு குறிப்பிட்ட நபரின் பெயர் அல்லது அடையாளப் பெயர்.",
      "modern_equivalent": "சேலா",
      "english_word": "Shelah",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "என்னை",
