      "definition_ta": "ஒரு ஆபத்திலிருந்து விலக்கிப் பாதுகாத்தல்.",
      "modern_equivalent": "தப்புவிர், காப்பாற்று",
      "english_word": "deliver",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "ஆத்துமா",
      "pos": "noun",
      "canonical": "ஆத்துமா",
      "definition_ta": "ஒரு மனிதனின் உயிர் அல்லது ஆன்மா.",
      "modern_equivalent": "ஆத்துமா",
      "english_word": "soul",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "என்னில்",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னைத் தானே குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "என்னில்",
      "english_word": "in me",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "தொய்ந்துபோகையில்",
      "pos": "verb",
      "canonical": "தொய்",
      "definition_ta": "பலவீனமடைதல் அல்லது சோர்ந்துபோதல்.",
      "modern_equivalent": "பலவீனமடைந்தபோது",
      "english_word": "faint",
      "source": "llm_single_pass"
    },
    {
      "verse": 7,
      "word": "கர்த்தரை",
      "pos": "noun",
      "canonical": "கர்த்தர்",
      "definition_ta": "கர்த்தர்: ஆளுகை செய்யும் அதிகாரம் கொண்ட இறைவன் அல்லது ஆண்டவர்.",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "the LORD",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "நினைத்தேன்;",
      "pos": "verb",
      "canonical": "நினை",
      "definition_ta": "மனதில் ஒரு கருத்தை அல்லது எண்ணத்தை வைத்திருத்தல்.",
      "modern_equivalent": "எண்ணினேன்",
      "english_word": "thought",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "அப்பொழுது",
      "pos": "adverb",
      "canonical": "அப்பொழுது",
      "definition_ta": "ஒரு குறிப்பிட்ட நிகழ்வு அல்லது காலத்தின் தொடக்கத்தில் நடக்கும் ஒரு நேரத்தைக் குறிக்கிறது.",
      "modern_equivalent": "அப்போது",
      "english_word": "Then",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "என்",
      "pos": "pronoun",
      "canonical": "என்",
      "definition_ta": "ஆதாம் தன்னைத்தானே குறிக்கப் பயன்படுத்திய ஒருமைப் பிரதிபெயர்.",
      "modern_equivalent": "என்னுடைய",
      "english_word": "my",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "விண்ணப்பம்",
      "pos": "noun",
      "canonical": "விண்ணப்பம்",
      "definition_ta": "ஒரு கோரிக்கை அல்லது வேண்டுகோளை எழுத்துப்பூர்வமாகவோ அல்லது வாய்மொழியாகவோ முன்வைத்தல்.",
      "modern_equivalent": "வேண்டுதல்",
      "english_word": "petition",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உமது",
      "pos": "pronoun",
      "canonical": "உமது",
      "definition_ta": "தேவன் அல்லது அதிகாரமிக்க ஒருவருடைய சொந்தத்தைக் குறிக்கும் மரியாதையான சொல்.",
      "modern_equivalent": "உமது",
      "english_word": "your",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "பரிசுத்த",
      "pos": "adjective",
      "canonical": "பரிசுத்தம்",
      "definition_ta": "தூய்மையான, அர்ப்பணிக்கப்பட்ட அல்லது புனிதமான நிலை.",
      "modern_equivalent": "தூய்மையான",
      "english_word": "holy",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "ஆலயத்திலே",
      "pos": "noun",
      "canonical": "ஆலயம்",
      "definition_ta": "தேவன் தொழப்படுவதற்காக பிரத்யேகமாக ஒதுக்கப்பட்ட புனிதமான இடம்.",
      "modern_equivalent": "கோவில்",
      "english_word": "temple",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "உம்மிடத்தில்",
      "pos": "particle",
      "canonical": "உம்",
      "definition_ta": "உங்களுடைய அல்லது உம்மோடு தொடர்புடைய என்பதைக் குறிக்கும் இடைச்சொல்.",
      "modern_equivalent": "உங்களிடம்",
      "english_word": "with you",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "வந்து",
      "pos": "verb",
      "canonical": "வா",
      "definition_ta": "ஒரு இடத்திலிருந்து மற்றொரு இடத்திற்கு நகர்ந்து வருதல்.",
      "modern_equivalent": "வந்தது",
      "english_word": "came",
      "source": "db_0ms"
    },
    {
      "verse": 7,
      "word": "சேர்ந்தது.",
      "pos": "verb",
      "canonical": "சேர்",
      "definition_ta": "ஒருவருடைய அல்லது ஒரு பொருளின் அருகில் வந்து இணைதல்.",
      "modern_equivalent": "சேர்ந்தது",
      "english_word": "sat down",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பொய்யான",
      "pos": "adjective",
      "canonical": "பொய்",
      "definition_ta": "உண்மை அல்லாத அல்லது பொய்யான தன்மை.",
      "modern_equivalent": "பொய்",
      "english_word": "false",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "மாயையைப்",
      "pos": "noun",
      "canonical": "மாயை",
      "definition_ta": "உண்மையற்ற அல்லது பொய்யான ஒரு தோற்றம்.",
      "modern_equivalent": "பொய்",
      "english_word": "deceit",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "பற்றிக்கொள்ளுகிறவர்கள்",
      "pos": "noun",
      "canonical": "பற்றிக்கொள்ளு",
      "definition_ta": "ஒரு பொருளை அல்லது எண்ணத்தை மனதிற்குள் ஆழமாக ஏற்றுக்கொண்டு அதனுடன் ஒன்றிப்போகும் நபர்கள்.",
      "modern_equivalent": "பற்றிக்கொள்பவர்கள்",
      "english_word": "those who cling",
      "source": "llm_single_pass"
    },
    {
      "verse": 8,
      "word": "தங்களுக்கு",
      "pos": "pronoun",
      "canonical": "தங்கள்",
      "definition_ta": "தங்களுக்கு எனவேகான உடை தயாரித்ததைக் குறிக்கும் பிரதிப் பெயர்.",
      "modern_equivalent": "அவர்களுக்கு",
      "english_word": "themselves",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "வரும்",
      "pos": "verb",
      "canonical": "வா",
      "definition_ta": "ஒரு இடத்திற்கு அல்லது நிலையை நோக்கி நகர்ந்து வருதல்.",
      "modern_equivalent": "வரும்",
      "english_word": "coming",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "கிருபையைப்",
      "pos": "noun",
      "canonical": "கிருபை",
      "definition_ta": "தேவனால் வழங்கப்படும் தயவு அல்லது அருள்.",
      "modern_equivalent": "அருள்",
      "english_word": "mercy",
      "source": "db_0ms"
    },
    {
      "verse": 8,
      "word": "போக்கடிக்கிறார்கள்.",
      "pos": "verb",
      "canonical": "போக்கடி",
      "definition_ta": "ஒரு பொருளை அல்லது வாய்ப்பை தன்னிடம் இருந்து விலக்கி அல்லது தள்ளிவிடுதல்.",
      "modern_equivalent": "தள்ளிவிடுகிறார்கள்",
      "english_word": "spurn",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "நானோவெனில்",
      "pos": "adverb",
      "canonical": "நானோவெனில்",
      "definition_ta": "அப்பொழுது அல்லது அந்த நேரத்தில் என்று பொருள்படும் வினையடை.",
      "modern_equivalent": "அப்பொழுது",
      "english_word": "Then",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "துதியின்",
      "pos": "noun",
      "canonical": "துதி",
      "definition_ta": "தேவனின் செயல்களுக்காகவும் மகிமைக்காகவும் செய்யப்படும் ஆராதனை அல்லது போற்றி.",
      "modern_equivalent": "ஆராதனை",
      "english_word": "praise",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "சத்தத்தோடே",
      "pos": "adverb",
      "canonical": "சத்தம்",
      "definition_ta": "உரக்க அல்லது சத்தமான முறையில்.",
      "modern_equivalent": "சத்தமாக",
      "english_word": "with a loud voice",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "உமக்குப்",
      "pos": "pronoun",
      "canonical": "உமக்கு",
      "definition_ta": "உன்னைப் பற்றியோ அல்லது உன்னோடு தொடர்புடையதோ என்று குறிக்கும் பிரதிப்பெயர்.",
      "modern_equivalent": "உனக்கு",
      "english_word": "to you",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பலியிடுவேன்;",
      "pos": "verb",
      "canonical": "பலியிடு",
      "definition_ta": "தேவனுக்காக அல்லது தெய்வங்களுக்காக ஒரு பொருளை அல்லது உயிரை அர்ப்பணித்தல்.",
      "modern_equivalent": "பலி கொடுத்தல்",
      "english_word": "to sacrifice",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "நான்",
      "pos": "pronoun",
      "canonical": "நான்",
      "definition_ta": "தன்னைத்தானே குறிக்கும் ஒருமைப் பிரதிப்பெயர்.",
      "modern_equivalent": "நான்",
      "english_word": "I",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பண்ணின",
      "pos": "verb",
      "canonical": "பண்ணு",
      "definition_ta": "ஒரு பொருளை உருவாக்குதல் அல்லது ஒரு செயலைச் செய்தல்.",
      "modern_equivalent": "செய்த",
      "english_word": "made",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "பொருத்தனையைச்",
      "pos": "noun",
      "canonical": "பொருத்தனை",
      "definition_ta": "ஒருவர் செய்த அல்லது தன்னிடம் உள்ள ஒரு பொருளை அல்லது காணிக்கையை குறிக்கும் சொல்.",
      "modern_equivalent": "பொருளை",
      "english_word": "the thing",
      "source": "llm_single_pass"
    },
    {
      "verse": 9,
      "word": "செலுத்துவேன்;",
      "pos": "verb",
      "canonical": "செலுத்து",
      "definition_ta": "ஒரு கடமைக்காகவோ அல்லது ஒருவருக்கு உரியதாகவோ ஒரு பொருளை அல்லது பணத்தை வழங்குதல்.",
      "modern_equivalent": "செலுத்துவேன்",
      "english_word": "will give",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "இரட்சிப்பு",
      "pos": "noun",
      "canonical": "இரட்சிப்பு",
      "definition_ta": "பாவத்திலிருந்து விடுதலையும் பாதுகாப்பும் பெறுதல்.",
      "modern_equivalent": "மீட்பு",
      "english_word": "salvation",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "கர்த்தருடையது",
      "pos": "noun",
      "canonical": "கர்த்தர்",
      "definition_ta": "ஆண்டவராகிய தேவன்.",
      "modern_equivalent": "கர்த்தருடையது",
      "english_word": "the Lord's",
      "source": "db_0ms"
    },
    {
      "verse": 9,
      "word": "என்றான்.",
      "pos": "verb",
      "canonical": "சொல்",
      "definition_ta": "ஒரு கருத்தை அல்லது செய்தியை வாய்மொழியாக வெளிப்படுத்துதல்.",
      "modern_equivalent": "சொன்னார்",
      "english_word": "said",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "கர்த்தர்",
      "pos": "particle",
      "canonical": "கர்த்தர்",
      "definition_ta": "சர்வ வல்லமையுள்ள இறைவனாகிய ஆண்டவரை குறிக்கும்.",
      "modern_equivalent": "ஆண்டவர்",
      "english_word": "LORD",
      "source": "db_disambiguated"
    },
    {
      "verse": 10,
      "word": "மீனுக்குக்",
      "pos": "noun",
      "canonical": "மீன்",
      "definition_ta": "நீரில் வாழும் ஒரு வகை நீர்வாழ் உயிரினம்.",
      "modern_equivalent": "மீன்",
      "english_word": "fish",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "கட்டளையிட்டார்,",
      "pos": "verb",
      "canonical": "கட்டளையிடு",
      "definition_ta": "ஒரு அதிகாரத்தில் இருந்து பிறருக்குக் கொடுக்கப்படும் கட்டளை அல்லது ஆணை.",
      "modern_equivalent": "ஆணையைிட்டார்",
      "english_word": "commanded",
      "source": "db_0ms"
    },
    {
      "verse": 10,
      "word": "அது",
      "pos": "pronoun",
      "canonical": "அது",
      "definition_ta": "முன்னதாகக் குறிப்பிடப்பட்ட ஆகாயவிரிவைக் குறிக்கும் பிரதிப் பெயர்.",
      "modern_equivalent": "அது",
      "english_word": "it",
      "source": "db_disambiguated"
    },
    {
      "verse": 10,
      "word": "யோனாவைக்",
      "pos": "noun",
      "canonical": "யோனா",
      "definition_ta": "தேவனுடைய தீர்க்கதரிசியாகிய ஒரு மனிதன்.",
      "modern_equivalent": "யோனா",
      "english_word": "Jonah",
      "source": "llm_single_pass"
    },
    {
      "verse": 10,
      "word": "கரையிலே",
      "pos": "noun",
      "canonical": "கரை",
      "definition_ta": "ஆறு அல்லது கடல் போன்ற நீர்நிலையின் ஓரம் அல்லது நிலப்பகுதி.",
      "modern_equivalent": "ஓரத்தில்",
      "english_word": "shore",
      "source": "db_0ms"
    },
    {
