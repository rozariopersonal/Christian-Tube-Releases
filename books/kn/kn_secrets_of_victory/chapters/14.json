[{"line":1,"page":67,"text":"ಅಧ್ಯಾಯ 14 ಪೀಠಿಕೆ-2 ದೇವರು ಯೇಸುವಿಗೆ ಮಾಡಿದ್ದನ್ನೇ ನಿನಗೂ ಮಾಡುವನು","contentType":"chapter_header","isHeading":true,"headingLevel":1},{"line":2,"page":67,"text":"1.ಭಾರದಿಂದಲೂ ಚಿಂತೆಯಿಂದಲೂ ಬಗ್ಗಿರುವಾಗ,","contentType":"p","isHeading":false,"headingLevel":0},{"line":3,"page":67,"text":"ನಿನ್ನ ಆತ್ಮ ಬೇಸರಗೊಳ್ಳದಿರಲಿ;","contentType":"p","isHeading":false,"headingLevel":0},{"line":4,"page":67,"text":"ನೀನು ಭಯಪಡಬೇಕಾಗಿಲ್ಲ,","contentType":"p","isHeading":false,"headingLevel":0},{"line":5,"page":67,"text":"ದೇವರು ಬಹು ಸಮೀಪವಾಗಿದ್ದಾನೆ.","contentType":"p","isHeading":false,"headingLevel":0},{"line":6,"page":67,"text":"ಆತನು ತನ್ನ ಪುತ್ರನನ್ನು ಪ್ರೀತಿಸಿದಂತೆ ನಿನ್ನನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ.","contentType":"p","isHeading":false,"headingLevel":0},{"line":7,"page":67,"text":"ನಿನಗೂ ಆತನು ಸಹಾಯಮಾಡುವನು;","contentType":"p","isHeading":false,"headingLevel":0},{"line":8,"page":67,"text":"ಆತನ ವಾಗ್ದಾನ ವಾಕ್ಯದಲ್ಲಿ ಕೇವಲ ಭರವಸವಿಡು.","contentType":"p","isHeading":false,"headingLevel":0},{"line":9,"page":67,"text":"ಆತನೇ ನಿನ್ನನ್ನು ನೋಡಿಕೊಳ್ಳುವನು.","contentType":"p","isHeading":false,"headingLevel":0},{"line":10,"page":67,"text":"ದೇವರು ಏನು ಮಾಡುವನೋ ಅದು ರಹಸ್ಯವಲ್ಲ;","contentType":"p","isHeading":false,"headingLevel":0},{"line":11,"page":67,"text":"ಆತನು ಯೇಸುವಿಗೆ ಮಾಡಿದ್ದನ್ನೇ ನಿನಗೂ ಮಾಡುವನು;","contentType":"p","isHeading":false,"headingLevel":0},{"line":12,"page":67,"text":"ಪರಾಕ್ರಮ ಶಕ್ತಿಯಿಂದ ಆತನು ನಿನ್ನನ್ನು ಬಲಪಡಿಸುವನು;","contentType":"p","isHeading":false,"headingLevel":0},{"line":13,"page":67,"text":"ದೇವರು ಏನು ಮಾಡುವನೋ ಅದು ರಹಸ್ಯವಲ್ಲ.","contentType":"p","isHeading":false,"headingLevel":0},{"line":14,"page":67,"text":"2.ಪಾಪವು ಕೆಟ್ಟದ್ದು ಈ ಲೋಕದಲ್ಲಿ ತುಂಬಿದ್ದರೂ","contentType":"p","isHeading":false,"headingLevel":0},{"line":15,"page":67,"text":"ನೀನು ಒತ್ತಡಕ್ಕೆ ಒಳಗಾಗಿದ್ದರೂ ದೇವ ವಾಕ್ಯವೋ ಸತ್ಯವಾಗಿದೆ.","contentType":"p","isHeading":false,"headingLevel":0},{"line":16,"page":67,"text":"“ಪಾಪವು ನಿನ್ನ ಮೇಲೆ ಅಧಿಕಾರ ನಡಿಸದು.\"","contentType":"p","isHeading":false,"headingLevel":0},{"line":17,"page":67,"text":"ಶೋಧನೆಯ ಎಳೆತ ಬಲವಾಗಿರುವಾಗ","contentType":"p","isHeading":false,"headingLevel":0},{"line":18,"page":67,"text":"ದೇವರ ಕೃಪೆಯೇ ನಿನಗಾಧಾರ;","contentType":"p","isHeading":false,"headingLevel":0},{"line":19,"page":67,"text":"ನೀನು ಯೇಸುವಿನ ಹಾಗೆ ನಡೆಯಲು ಸಾಧ್ಯ","contentType":"p","isHeading":false,"headingLevel":0},{"line":20,"page":67,"text":"ಪ್ರತಿ ದಿನವೂ ಜಯದಲ್ಲಿ.","contentType":"p","isHeading":false,"headingLevel":0},{"line":21,"page":67,"text":"3.ನೋವೂ ರೋಗವೂ ನಿನಗೆ ಬರುವಾಗ","contentType":"p","isHeading":false,"headingLevel":0},{"line":22,"page":67,"text":"ನಿನ್ನ ಪ್ರಿಯರನ್ನು ಅವು ತಾಕುವಾಗ,","contentType":"p","isHeading":false,"headingLevel":0},{"line":23,"page":67,"text":"ನೀನು ಭಾವಿಸುವುದು ಹೇಗೆಂದು ದೇವರು ಬಲ್ಲನು","contentType":"p","isHeading":false,"headingLevel":0},{"line":24,"page":67,"text":"ಸ್ವಸ್ಥಮಾಡಲು ಆತನಿಗೆ ಶಕ್ತಿಯುಂಟು.","contentType":"p","isHeading":false,"headingLevel":0},{"line":25,"page":67,"text":"ನಿನ್ನ ತಂದೆ ನಿನ್ನವಶ್ಯವನ್ನು ಒದಗಿಸುವನು","contentType":"p","isHeading":false,"headingLevel":0},{"line":26,"page":67,"text":"ಆತನು ನಂಬಿಗಸ್ತನೂ ಸತ್ಯವಂತನೂ ಆಗಿರುವನು:","contentType":"p","isHeading":false,"headingLevel":0},{"line":27,"page":67,"text":"ಆತನು ಯೇಸುವನ್ನು ಪರಾಮರಿಸಿದಂತೆಯೇ","contentType":"p","isHeading":false,"headingLevel":0},{"line":28,"page":67,"text":"ನಿನ್ನನ್ನೂ ಪರಾಮರಿಸುವನು.","contentType":"p","isHeading":false,"headingLevel":0},{"line":29,"page":67,"text":"4. ಓ ಎಂಥಾ ಮಹಿಮೆಯ ಸಂತೈಸುವಿಕೆ ಇದು","contentType":"p","isHeading":false,"headingLevel":0},{"line":30,"page":67,"text":"ಯೇಸು ನಿನ್ನ ಕತ೯ನೆಂದು","contentType":"p","isHeading":false,"headingLevel":0},{"line":31,"page":67,"text":"ನಿನ್ನ ಹಿರಿಯ ಅಣ್ಣನೆಂದೂ ತಿಳಿದಿದ್ದರೆ","contentType":"p","isHeading":false,"headingLevel":0},{"line":32,"page":67,"text":"ದೇವರಿಗಿರುವುದೆಲ್ಲಾ ಈಗ ನಿನ್ನದು","contentType":"p","isHeading":false,"headingLevel":0},{"line":33,"page":67,"text":"ನಿನ್ನನ್ನು ಎಂದಿಗೂ ತೊರೆಯುವುದಿಲ್ಲ.","contentType":"p","isHeading":false,"headingLevel":0},{"line":34,"page":67,"text":"ಈಗ ದೇವರು ನಿನ್ನ ಪರವಾಗಿರುವುದರಿಂದ","contentType":"p","isHeading":false,"headingLevel":0},{"line":35,"page":67,"text":"ನಿನ್ನ ವೈರಿ ಈಗ ಯಾರು?","contentType":"p","isHeading":false,"headingLevel":0},{"line":36,"page":67,"text":"- ಝ್ಯಾಕ್ ಪೂನನ್","contentType":"p","isHeading":false,"headingLevel":0}]