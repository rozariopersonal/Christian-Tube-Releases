[{"line":1,"page":1,"text":"அட்டவணை","contentType":"chapter_header","isHeading":true,"headingLevel":1},{"line":2,"page":1,"text":"பொருளடக்கம்","contentType":"h2","isHeading":true,"headingLevel":2},{"line":3,"page":1,"text":"1. பணிவிடையும் தியாகமும் உள்ள ஆவி","contentType":"p","isHeading":false,"headingLevel":0},{"line":4,"page":1,"text":"2. பரம தகப்பனிடம் செலவுசெய்யும் நேரம்","contentType":"p","isHeading":false,"headingLevel":0},{"line":5,"page":1,"text":"3. ஒரு தாயின் இதயத்துடிப்பு","contentType":"p","isHeading":false,"headingLevel":0},{"line":6,"page":1,"text":"4. எவ்வித வருத்தமுமின்றி இயேசுவை நோக்கி ஓடுங்கள்!","contentType":"p","isHeading":false,"headingLevel":0}]