[{"line":1,"page":116,"text":"अध्याय 10 समर्पण का गीत","contentType":"chapter_header","isHeading":true,"headingLevel":1},{"line":2,"page":116,"text":"विवाह की प्रार्थना और समर्पण का गीत","contentType":"h3","isHeading":true,"headingLevel":3},{"line":3,"page":116,"text":"समर्पण में प्रभु सब हम है झुकते,","contentType":"p","isHeading":false,"headingLevel":0},{"line":4,"page":116,"text":"तेरे लोहू से गए खरीदे,","contentType":"p","isHeading":false,"headingLevel":0},{"line":5,"page":116,"text":"तेरे है हम, सदा तेरे रहेंगे","contentType":"p","isHeading":false,"headingLevel":0},{"line":6,"page":116,"text":"तू भी हमारा, विनती हम करते ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":7,"page":116,"text":"हमारी प्रार्थना कल्पनाओं से बढकर,","contentType":"p","isHeading":false,"headingLevel":0},{"line":8,"page":116,"text":"तेरी आशिषें बरसीं जीवन पर,","contentType":"p","isHeading":false,"headingLevel":0},{"line":9,"page":116,"text":"आभारी हृदय तेरी, स्तुति से भरे,","contentType":"p","isHeading":false,"headingLevel":0},{"line":10,"page":116,"text":"अनन्त प्रेम में, हम तुझसे बंधे ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":11,"page":116,"text":"दुर्बल लाचार है,यह जानकर भी,","contentType":"p","isHeading":false,"headingLevel":0},{"line":12,"page":116,"text":"तेरी सेवा में, नित रत रहेंगे,","contentType":"p","isHeading":false,"headingLevel":0},{"line":13,"page":116,"text":"तू सर्व सामर्थी, यह जानकर भी,","contentType":"p","isHeading":false,"headingLevel":0},{"line":14,"page":116,"text":"शक्ति तेरी से, सफल बनेंगे ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":15,"page":116,"text":"दुखों में तेरे, सहभागी बनना,","contentType":"p","isHeading":false,"headingLevel":0},{"line":16,"page":116,"text":"क्रूस पर तेरे, घमंड करना,","contentType":"p","isHeading":false,"headingLevel":0},{"line":17,"page":116,"text":"यही इच्छा, तुझे प्रसन्न करें,","contentType":"p","isHeading":false,"headingLevel":0},{"line":18,"page":116,"text":"सांसारिक लाभ को, तुच्छ सा जानें ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":19,"page":116,"text":"अनादर उपहास, यदि, संसार से झेले,","contentType":"p","isHeading":false,"headingLevel":0},{"line":20,"page":116,"text":"दुख व परीक्षाएं, पथ पर आ घेरे,","contentType":"p","isHeading":false,"headingLevel":0},{"line":21,"page":116,"text":"साथ ही चलेंगे, तोभी हम तेरे,","contentType":"p","isHeading":false,"headingLevel":0},{"line":22,"page":116,"text":"प्रेम मे बढेंगे, दिनों दिन तेरे ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":23,"page":116,"text":"आनंद दे हमे रोज अन्य लोगों की सहायता का,","contentType":"p","isHeading":false,"headingLevel":0},{"line":24,"page":116,"text":"उनके आँसू-पीडा में भाग लेने का,","contentType":"p","isHeading":false,"headingLevel":0},{"line":25,"page":116,"text":"कलवरी तक उनकी, दृष्टि उठाएं,","contentType":"p","isHeading":false,"headingLevel":0},{"line":26,"page":116,"text":"ताकि पापों से वे भी छुटकारा पाएं ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":27,"page":116,"text":"भर दे सामर्थ से, अपने आत्मा के,","contentType":"p","isHeading":false,"headingLevel":0},{"line":28,"page":116,"text":"बनें हम आशिष, मानव जाति के,","contentType":"p","isHeading":false,"headingLevel":0},{"line":29,"page":116,"text":"जीवन तेरा हममें निर्मल स्त्रोत सा बहे","contentType":"p","isHeading":false,"headingLevel":0},{"line":30,"page":116,"text":"सुगंध तेरी हमसे सुदूर फैले ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":31,"page":116,"text":"कामना सदा तेरी इच्छा पूर्ति की,","contentType":"p","isHeading":false,"headingLevel":0},{"line":32,"page":116,"text":"तेरे लिए सिर्फ, जीवित रहने की,","contentType":"p","isHeading":false,"headingLevel":0},{"line":33,"page":116,"text":"उस दिन तक जब हम, विभव में तेरे,","contentType":"p","isHeading":false,"headingLevel":0},{"line":34,"page":116,"text":"शामिल हो सदैव, राज्य संग करें ।","contentType":"p","isHeading":false,"headingLevel":0},{"line":35,"page":116,"text":"Share","contentType":"h