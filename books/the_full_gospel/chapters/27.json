[{"line":1,"page":297,"text":"Chapter 26 Proving God's Perfect Will","contentType":"chapter_header","isHeading":true,"headingLevel":1},{"line":2,"page":297,"text":"Chapter 26 Proving God's Perfect Will","contentType":"h3","isHeading":true,"headingLevel":3},{"line":3,"page":297,"text":"When faced with an issue concerning which we are unsure as to whether it is God's will or not, it is good for us to ask ourselves twelve questions. As we answer these questions honestly, it will become increasingly clear to us what the will of God is.","contentType":"p","isHeading":false,"headingLevel":0},{"line":4,"page":297,"text":"(Look up the Scripture references and meditate on them).","contentType":"p","isHeading":false,"headingLevel":0},{"line":5,"page":297,"text":"Share","contentType":"h3","isHeading":true,"headingLevel":3},{"line":6,"page":297,"text":"Who Am I","contentType":"h3","isHeading":true,"headingLevel":3},{"line":7,"page":297,"text":"Our Message","contentType":"h3","isHeading":true,"headingLevel":3},{"line":8,"page":297,"text":"Resources","contentType":"h3","isHeading":true,"headingLevel":3},{"line":9,"page":297,"text":"Study Series","contentType":"h3","isHeading":true,"headingLevel":3},{"line":10,"page":297,"text":"About us","contentType":"h3","isHeading":true,"headingLevel":3},{"line":11,"page":297,"text":"CHRISTIAN FELLOWSHIP CHURCH","contentType":"h3","isHeading":true,"headingLevel":3}]