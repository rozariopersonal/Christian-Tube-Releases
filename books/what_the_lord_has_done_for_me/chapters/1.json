[{"line":1,"page":1,"text":"Chapter 0 Timeline","contentType":"chapter_header","isHeading":true,"headingLevel":1},{"line":2,"page":1,"text":"Chapter 0 Timeline","contentType":"h3","isHeading":true,"headingLevel":3},{"line":3,"page":1,"text":"Timeline","contentType":"h3","isHeading":true,"headingLevel":3},{"line":4,"page":1,"text":"Annie Poonen","contentType":"h3","isHeading":true,"headingLevel":3},{"line":5,"page":1,"text":"Born on 25 December 1942","contentType":"p","isHeading":false,"headingLevel":0},{"line":6,"page":1,"text":"\"I'll bless the Hand that guided, I'll bless the Heart that planned","contentType":"p","isHeading":false,"headingLevel":0},{"line":7,"page":1,"text":"When throned where glory dwelleth in Immanuel's land.\"","contentType":"p","isHeading":false,"headingLevel":0},{"line":8,"page":1,"text":"------------------------------------------------------------------------","contentType":"p","isHeading":false,"headingLevel":0},{"line":9,"page":1,"text":"The Lord says,","contentType":"p","isHeading":false,"headingLevel":0},{"line":10,"page":1,"text":"\"I will lead My people by roads they have never travelled.","contentType":"p","isHeading":false,"headingLevel":0},{"line":11,"page":1,"text":"I will turn their darkness into light and make the rough paths smooth before them.","contentType":"p","isHeading":false,"headingLevel":0},{"line":12,"page":1,"text":"These are My promises, and I will keep them without fail.\" (Isaiah 42:16)","contentType":"p","isHeading":false,"headingLevel":0}]