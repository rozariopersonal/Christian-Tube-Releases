[{"line":1,"page":63,"text":"Chapter 14 Appendix 2. What God Did For Jesus....","contentType":"chapter_header","isHeading":true,"headingLevel":1},{"line":2,"page":63,"text":"Chapter 14 Appendix 2. What God Did For Jesus....","contentType":"h3","isHeading":true,"headingLevel":3},{"line":3,"page":63,"text":"1. When bowed with burdens and with care,","contentType":"p","isHeading":false,"headingLevel":0},{"line":4,"page":63,"text":"Your soul is in despair;","contentType":"p","isHeading":false,"headingLevel":0},{"line":5,"page":63,"text":"You don't have to fear,","contentType":"p","isHeading":false,"headingLevel":0},{"line":6,"page":63,"text":"God is very near.","contentType":"p","isHeading":false,"headingLevel":0},{"line":7,"page":63,"text":"He loves you as He loved His Son","contentType":"p","isHeading":false,"headingLevel":0},{"line":8,"page":63,"text":"And He will help you too;","contentType":"p","isHeading":false,"headingLevel":0},{"line":9,"page":63,"text":"Just trust His word of promise","contentType":"p","isHeading":false,"headingLevel":0},{"line":10,"page":63,"text":"And He will see you through.","contentType":"p","isHeading":false,"headingLevel":0},{"line":11,"page":63,"text":"This is the good news - what God can do;","contentType":"p","isHeading":false,"headingLevel":0},{"line":12,"page":63,"text":"What He's done for Jesus He'll do for you;","contentType":"p","isHeading":false,"headingLevel":0},{"line":13,"page":63,"text":"With mighty power He'll strengthen you;","contentType":"p","isHeading":false,"headingLevel":0},{"line":14,"page":63,"text":"There is no end to what God can do.","contentType":"p","isHeading":false,"headingLevel":0},{"line":15,"page":63,"text":"2. Though sin and evil fill this world","contentType":"p","isHeading":false,"headingLevel":0},{"line":16,"page":63,"text":"And you are overcome;","contentType":"p","isHeading":false,"headingLevel":0},{"line":17,"page":63,"text":"Yet God's Word is true -","contentType":"p","isHeading":false,"headingLevel":0},{"line":18,"page":63,"text":"\"Sin can't reign o'er you.\"","contentType":"p","isHeading":false,"headingLevel":0},{"line":19,"page":63,"text":"And when temptations's pull is strong","contentType":"p","isHeading":false,"headingLevel":0},{"line":20,"page":63,"text":"God's grace will be your stay;","contentType":"p","isHeading":false,"headingLevel":0},{"line":21,"page":63,"text":"So you can walk like Jesus","contentType":"p","isHeading":false,"headingLevel":0},{"line":22,"page":63,"text":"In vict'ry every day.","contentType":"p","isHeading":false,"headingLevel":0},{"line":23,"page":63,"text":"3. When pain and sickness come to you","contentType":"p","isHeading":false,"headingLevel":0},{"line":24,"page":63,"text":"And touch your loved ones too,","contentType":"p","isHeading":false,"headingLevel":0},{"line":25,"page":63,"text":"God knows how you feel -","contentType":"p","isHeading":false,"headingLevel":0},{"line":26,"page":63,"text":"He has power to heal.","contentType":"p","isHeading":false,"headingLevel":0},{"line":27,"page":63,"text":"Your Father will provide your need -","contentType":"p","isHeading":false,"headingLevel":0},{"line":28,"page":63,"text":"He's faithful and He's true;","contentType":"p","isHeading":false,"headingLevel":0},{"line":29,"page":63,"text":"And as He cared for Jesus","contentType":"p","isHeading":false,"headingLevel":0},{"line":30,"page":63,"text":"He will care for you.","contentType":"p","isHeading":false,"headingLevel":0},{"line":31,"page":63,"text":"4. O what a glorious comfort this -","contentType":"p","isHeading":false,"headingLevel":0},{"line":32,"page":63,"text":"If you have come to know","contentType":"p","isHeading":false,"headingLevel":0},{"line":33,"page":63,"text":"Jesus as your Lord","contentType":"p","isHeading":false,"headingLevel":0},{"line":34,"page":63,"text":"And Elder Brother too.","contentType":"p","isHeading":false,"headingLevel":0},{"line":35,"page":63,"text":"For all God has is now your own","contentType":"p","isHeading":false,"headingLevel":0},{"line":36,"page":63,"text":"And He won't let you go;","contentType":"p","isHeading":false,"headingLevel":0},{"line":37,"page":63,"text":"And now that God is for you","contentType":"p","isHeading":false,"headingLevel":0},{"line":38,"page":63,"text":"Who can be your foe? -","contentType":"p","isHeading":false,"headingLevel":0}]